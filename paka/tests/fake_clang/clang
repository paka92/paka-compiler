#!/bin/sh
# Stand-in for clang in the build tests. With FAKE_CLANG_LOG set: writes its arguments, one per
# line, to that file and exits 0. Without it: writes to both streams and exits 7.
if [ -n "$FAKE_CLANG_LOG" ]; then
    printf '%s\n' "$@" > "$FAKE_CLANG_LOG"
    exit 0
fi
echo fake-clang-stdout
echo fake-clang-stderr >&2
exit 7
