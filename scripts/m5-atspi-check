#!/usr/bin/env python3
"""The M5-40 screen-reader check. Opens the counter and the to-do sample in windows, on a private
session bus with accessibility switched on there, and finds each sample's buttons and input by
role and name over AT-SPI and in Orca's debug log. The desktop's own setting is never changed,
and nothing is spoken: Orca is given no speech server to reach.

--switch-off leaves the switch off and starts no Orca, which would switch it on: the check must
then fail. Exits 0 when everything is found, 1 when not, 77 when skipped for want of a display.
Logs go to target/tmp/m5-atspi-check. Needs target/release/paka-runner, built beforehand."""

import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

try:
    import gi

    gi.require_version("Atspi", "2.0")
    from gi.repository import Atspi, Gio, GLib
except (ImportError, ValueError):
    Atspi = None

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
RUNNER = os.path.join(ROOT, "target/release/paka-runner")
TMP = os.path.join(ROOT, "target/tmp")
LOG = os.path.join(TMP, "m5-atspi-check")
ORCA_LOG = os.path.join(LOG, "orca.txt")
INNER = "PAKA_ATSPI_INNER"
WAIT = 10.0

# Each sample: its case, its app, and the AT-SPI role and name of each element it must show.
SAMPLES = [
    ("sample_counter", "counter", [("PUSH_BUTTON", "-"), ("PUSH_BUTTON", "+")]),
    ("sample_todo", "todo", [("PUSH_BUTTON", "Add"), ("ENTRY", "new")]),
]


def main():
    off = "--switch-off" in sys.argv[1:]
    if os.environ.get(INNER):
        return inner(off)
    if not os.environ.get("WAYLAND_DISPLAY"):
        print("skipped: WAYLAND_DISPLAY is unset, so no window can open")
        return 77
    missing = [t for t in ("dbus-run-session", "orca") if not shutil.which(t)]
    missing += [p for p in ("/usr/libexec/at-spi-bus-launcher", RUNNER) if not os.path.exists(p)]
    if Atspi is None:
        missing.append("python3 gi with Atspi 2.0")
    if missing:
        print("FAIL  missing: " + ", ".join(missing))
        return 1
    os.makedirs(LOG, exist_ok=True)
    # The bus and its services write to their own log; the check's lines come back on `out`.
    out = os.dup(1)
    with tempfile.TemporaryDirectory(dir=TMP) as home, open(os.path.join(LOG, "bus.txt"), "w") as bus:
        command = ["dbus-run-session", "--", sys.executable, __file__, *sys.argv[1:]]
        env = private_env(home, out)
        return subprocess.call(command, env=env, stdout=bus, stderr=bus, pass_fds=[out])


def private_env(home, out):
    """An environment whose settings, files and sockets stay in `home`: settings in memory, no
    speech server or file-system daemon to reach, and the desktop's Wayland socket by its path."""
    env = dict(os.environ, GSETTINGS_BACKEND="memory", GIO_USE_VFS="local", **{INNER: str(out)})
    display = env["WAYLAND_DISPLAY"]
    env["WAYLAND_DISPLAY"] = os.path.join(env.get("XDG_RUNTIME_DIR", ""), display)
    for name in ("XDG_RUNTIME_DIR", "XDG_DATA_HOME", "XDG_CONFIG_HOME", "XDG_CACHE_HOME"):
        env[name] = os.path.join(home, name.lower())
        os.makedirs(env[name], mode=0o700)
    env["SPEECHD_ADDRESS"] = "unix_socket:" + os.path.join(home, "no-speech")
    env["SPEECHD_CMD"] = os.path.join(home, "no-speech")
    env.pop("DISPLAY", None)
    return env


def inner(off):
    sys.stdout = os.fdopen(int(os.environ[INNER]), "w", buffering=1)
    if not off:
        switch_on()
    if os.path.exists(ORCA_LOG):
        os.remove(ORCA_LOG)
    orca = None
    if not off:
        out = open(os.path.join(LOG, "orca.out"), "w")
        orca = subprocess.Popen(["orca", "--debug-file", ORCA_LOG], stdout=out, stderr=out)
        orca_up = find_app(lambda a: a.get_name() == "orca")
        print(f"{'pass' if orca_up else 'FAIL'}  Orca is on the AT-SPI bus")
    Atspi.init()
    try:
        failed = [app for case, app, wanted in SAMPLES if not check_sample(case, app, wanted)]
    finally:
        if orca:
            orca.terminate()
            orca.wait(10)
    if orca and not (orca_up and check_orca()):
        failed.append("orca")
    return 1 if failed else 0


def switch_on():
    """Switches accessibility on in this private session, as the desktop's switch would."""
    on = GLib.Variant("(ssv)", ("org.a11y.Status", "IsEnabled", GLib.Variant("b", True)))
    Gio.bus_get_sync(Gio.BusType.SESSION).call_sync(
        "org.a11y.Bus", "/org/a11y/bus", "org.freedesktop.DBus.Properties", "Set", on,
        None, Gio.DBusCallFlags.NONE, -1, None,
    )


def check_sample(case, app, wanted):
    """Opens `case`'s `app` in a window and finds `wanted` over AT-SPI, giving each one focus so
    that Orca hears of it."""
    text = open(os.path.join(ROOT, "tests/cases/examples", case, "main.paka")).read()
    stderr = open(os.path.join(LOG, app + ".err"), "w")
    runner = subprocess.Popen(
        [RUNNER], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=stderr, text=True
    )
    try:
        ask(runner, {"files": [{"path": "main.paka", "text": text}]})
        run = ask(runner, {"app": app, "args": [], "limit_ms": 60000, "max_bytes": 65536})
        if run.get("window") is not True:
            print(f"FAIL  {app}: no window: {run}")
            return False
        found = find(runner.pid, wanted)
        for role, name in wanted:
            node = found.get((role, name))
            print(f"{'pass' if node else 'FAIL'}  {app}: AT-SPI {role_name(role)} \"{name}\"")
            if node:
                node.get_component_iface().grab_focus()
                time.sleep(0.5)
        return len(found) == len(wanted)
    finally:
        runner.stdin.close()
        try:
            runner.wait(10)
        except subprocess.TimeoutExpired:
            runner.kill()
            runner.wait()


def ask(runner, request):
    runner.stdin.write(json.dumps(request) + "\n")
    runner.stdin.flush()
    return json.loads(runner.stdout.readline())


def find(pid, wanted):
    """The nodes of `wanted` in the application of process `pid`, waiting up to WAIT seconds for
    all of them."""
    found = {}

    def walked(application):
        if application.get_process_id() == pid:
            walk(application, wanted, found)
        return len(found) == len(wanted)

    find_app(walked)
    return found


def find_app(test):
    """Whether `test` holds for an application on the AT-SPI bus within WAIT seconds."""
    end = time.monotonic() + WAIT
    while time.monotonic() < end:
        desktop = Atspi.get_desktop(0)
        children = (desktop.get_child_at_index(i) for i in range(desktop.get_child_count()))
        if any(test(a) for a in children if a):
            return True
        time.sleep(0.2)
    return False


def walk(node, wanted, found):
    for role, name in wanted:
        if node.get_role() == getattr(Atspi.Role, role) and node.get_name() == name:
            found[(role, name)] = node
    for i in range(node.get_child_count()):
        child = node.get_child_at_index(i)
        if child:
            walk(child, wanted, found)


def role_name(role):
    return Atspi.role_get_name(getattr(Atspi.Role, role))


def check_orca():
    """Whether Orca's debug log moves its focus to every wanted element, by role and name."""
    log = open(ORCA_LOG, errors="replace").read() if os.path.exists(ORCA_LOG) else ""
    ok = True
    for _, app, wanted in SAMPLES:
        for role, name in wanted:
            seen = f"to [{role_name(role)}: '{name}' (" in log
            print(f"{'pass' if seen else 'FAIL'}  {app}: Orca {role_name(role)} \"{name}\"")
            ok &= seen
    return ok


if __name__ == "__main__":
    sys.exit(main())
