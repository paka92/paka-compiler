#!/usr/bin/env bash
# M6-25: the three-back-end fuzz. Runs `paka-diff --fuzz-release` on WORKERS processes over
# consecutive seed blocks until HOURS have passed. OUT/run.txt records the commit and settings,
# OUT/blocks.log one line per block (first seed, count, status, seconds), and every divergence is
# kept, shrunk, as a run case under OUT/kept. Builds' scratch goes to OUT/tmp, on OUT's disk.
set -u
usage="usage: scripts/m6-25-fuzz OUT [HOURS] [WORKERS] [FIRST] [BLOCK]"
out=${1:?$usage}
hours=${2:-24}
workers=${3:-$(nproc)}
first=${4:-1000000}
block=${5:-200}
root=$(cd "$(dirname "$0")/.." && pwd)
bin=${CARGO_TARGET_DIR:-$root/target}/release

cargo build --release --locked --offline --manifest-path "$root/Cargo.toml" || exit 1
mkdir -p "$out/kept" "$out/logs" "$out/tmp"
export TMPDIR
TMPDIR=$(cd "$out/tmp" && pwd)
end=$(( $(date +%s) + $(awk -v h="$hours" 'BEGIN { print int(h * 3600) }') ))
{
    echo "commit $(git -C "$root" rev-parse HEAD)"
    echo "started $(date -u +%FT%TZ)"
    echo "hours $hours workers $workers first $first block $block"
} > "$out/run.txt"

worker() {
    local w=$1 i=$1 seed start status
    while (( $(date +%s) < end )); do
        seed=$(( first + i * block ))
        start=$(date +%s)
        "$bin/paka-diff" --fuzz-release "$seed" "$block" "$out/kept" \
            > "$out/logs/$seed.out" 2>&1
        status=$?
        echo "$seed $block $status $(( $(date +%s) - start ))" >> "$out/blocks.log"
        (( status == 0 )) && rm -f "$out/logs/$seed.out"
        i=$(( i + workers ))
    done
}

for (( w = 0; w < workers; w++ )); do worker "$w" & done
wait
echo "ended $(date -u +%FT%TZ)" >> "$out/run.txt"
echo "blocks: $(wc -l < "$out/blocks.log"), failed: $(awk '$3 != 0' "$out/blocks.log" | wc -l)," \
    "kept: $(ls "$out/kept" | wc -l)" | tee -a "$out/run.txt"
