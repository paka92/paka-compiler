// Plain matrix product of two square matrices held in flat lists.

enum Msg { Start }

fn randoms(n: Int, seed: Int) -> List<Float> {
  var xs = list_of(0.0, count: n)
  var s = seed
  for i in 0..<n {
    s = wrap_add(wrap_mul(s, 6364136223846793005), 1442695040888963407)
    xs[i] = to_float(bit_and(shift_right(s, 11), 9007199254740991)) / 9007199254740992.0
  }
  xs
}

fn multiply(a: List<Float>, b: List<Float>, n: Int) -> List<Float> {
  var c = list_of(0.0, count: n * n)
  for i in 0..<n {
    for k in 0..<n {
      let aik = a[i * n + k]
      for j in 0..<n {
        c[i * n + j] += aik * b[k * n + j]
      }
    }
  }
  c
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let n = 1500
  let c = multiply(randoms(n * n, 1), randoms(n * n, 2), n)
  var total = 0.0
  for x in c {
    total += x
  }
  let checksum = to_int(total * 1000000.0)
  [Print("{checksum}"), Exit]
}

app matmul {
  start: Start
  update: update
  grants: [Console]
}
