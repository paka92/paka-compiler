// Count the primes below N with a sieve of flags, for a run of N.

enum Msg { Start }

fn count_primes(n: Int) -> Int {
  var prime = list_of(true, count: n)
  var count = 0
  for i in 2..<n {
    if prime[i] {
      count += 1
      var j = i * i
      while j < n {
        prime[j] = false
        j += i
      }
    }
  }
  count
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var total = 0
  for r in 0..<80 {
    total += count_primes(10000000 + r)
  }
  [Print("{total}"), Exit]
}

app sieve {
  start: Start
  update: update
  grants: [Console]
}
