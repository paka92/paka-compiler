string.len | "abc" | 3
string.len | "caf\u{E9}" | 4
string.len | "e\u{301}" | 2
string.len | "日本語" | 3
string.len | "😀" | 1
string.len | "a😀b" | 3
string.len | "\n" | 1
string.index | "abc" 0 | "a"
string.index | "abc" 2 | "c"
string.index | "café" 3 | "é"
string.index | "日本語" 1 | "本"
string.index | "a😀b" 1 | "😀"
string.index | "a😀b" 2 | "b"
string.index | "e\u{301}" 1 | "\u{301}"
string.index | "abc" 3 | trap out_of_bounds
string.index | "abc" -1 | trap out_of_bounds
string.index | "abc" MAX | trap out_of_bounds
string.index | "" 0 | trap out_of_bounds
string.index | "日本語" 3 | trap out_of_bounds
string.slice | "abc" 0 3 | "abc"
string.slice | "abc" 1 2 | "b"
string.slice | "abc" 1 1 | ""
string.slice | "abc" 0 0 | ""
string.slice | "abc" 3 3 | ""
string.slice | "" 0 0 | ""
string.slice | "café" 2 4 | "fé"
string.slice | "日本語" 1 3 | "本語"
string.slice | "a😀b" 1 2 | "😀"
string.slice | "a😀b" 0 2 | "a😀"
string.slice | "a😀b" 2 3 | "b"
string.slice | "abc" 2 1 | trap out_of_bounds
string.slice | "abc" 0 4 | trap out_of_bounds
string.slice | "abc" -1 2 | trap out_of_bounds
string.slice | "abc" 4 4 | trap out_of_bounds
string.slice | "日本語" 0 4 | trap out_of_bounds

# ---- String: equality and order by code point value, proper prefix first (2.5)
string.eq | "" "" | true
string.eq | "abc" "abc" | true
string.eq | "abc" "abd" | false
string.eq | "a" "A" | false
string.eq | "é" "é" | true
string.eq | "\u{E9}" "e\u{301}" | false
string.ne | "" "" | false
string.ne | "abc" "abd" | true
string.ne | "\u{E9}" "e\u{301}" | true
string.ne | "é" "é" | false
string.lt | "Z" "a" | true
string.lt | "a" "Z" | false
string.lt | "é" "z" | false
string.lt | "" "a" | true
string.lt | "ab" "abc" | true
string.lt | "abc" "ab" | false
string.lt | "a" "a" | false
string.lt | "a" "b" | true
string.lt | "😀" "\u{FFFF}" | false
string.lt | "\u{FFFF}" "😀" | true
string.lt | "\u{10000}" "\u{E000}" | false
string.le | "a" "a" | true
string.le | "ab" "abc" | true
string.le | "abc" "ab" | false
string.le | "" "" | true
string.le | "é" "z" | false
string.le | "😀" "\u{FFFF}" | false
string.gt | "é" "z" | true
string.gt | "a" "Z" | true
string.gt | "abc" "ab" | true
string.gt | "ab" "abc" | false
string.gt | "a" "a" | false
string.gt | "😀" "\u{FFFF}" | true
string.ge | "é" "z" | true
string.ge | "a" "a" | true
string.ge | "" "a" | false
string.ge | "ab" "abc" | false
string.ge | "😀" "\u{FFFF}" | true

# ---- String: join, min, max, text, code_at, from_code (2.3, 2.5)
string.add | "" "" | ""
string.add | "a" "b" | "ab"
string.add | "" "x" | "x"
string.add | "x" "" | "x"
string.add | "café" "😀" | "café😀"
string.min | "a" "b" | "a"
string.min | "b" "a" | "a"
string.min | "é" "z" | "z"
string.min | "" "a" | ""
string.min | "ab" "abc" | "ab"
string.min | "x" "x" | "x"
string.max | "a" "b" | "b"
string.max | "b" "a" | "b"
string.max | "é" "z" | "é"
string.max | "" "a" | "a"
string.max | "ab" "abc" | "abc"
string.max | "x" "x" | "x"
string.text | "hi" | "hi"
string.text | "" | ""
string.text | "café 😀" | "café 😀"
code_at | "abc" 0 | 97
code_at | "abc" 2 | 99
code_at | "é" 0 | 233
code_at | "日" 0 | 26085
code_at | "😀" 0 | 128512
code_at | "\u{10FFFF}" 0 | 1114111
code_at | "e\u{301}" 1 | 769
code_at | "abc" 3 | trap out_of_bounds
code_at | "abc" -1 | trap out_of_bounds
code_at | "" 0 | trap out_of_bounds
from_code | 97 | "a"
from_code | 10 | "\n"
from_code | 0 | "\u{0}"
from_code | 233 | "é"
from_code | 128512 | "😀"
from_code | 55295 | "\u{D7FF}"
from_code | 57344 | "\u{E000}"
from_code | 1114111 | "\u{10FFFF}"
from_code | 55296 | trap bad_conversion
from_code | 57343 | trap bad_conversion
from_code | 1114112 | trap bad_conversion
from_code | -1 | trap bad_conversion
from_code | MAX | trap bad_conversion
from_code | MIN | trap bad_conversion

# ---- Bool (1.13, 2.3)
bool.not | true | false
bool.not | false | true
bool.and | true true | true
bool.and | true false | false
bool.and | false true | false
bool.and | false false | false
bool.or | true true | true
bool.or | true false | true
bool.or | false true | true
bool.or | false false | false
bool.eq | true true | true
bool.eq | true false | false
bool.eq | false true | false
bool.eq | false false | true
bool.ne | true true | false
bool.ne | true false | true
bool.ne | false true | true
bool.ne | false false | false
bool.text | true | "true"
bool.text | false | "false"

# ---- parse_float: too large and too small (2.3)
parse_float | "" | some inf
parse_float | "-" | some -inf
parse_float | ".5" | some inf
parse_float | "0." | some 0.0
parse_float | "-0." | some -0.0
parse_float | "0." | some 0.0
parse_float | "0." | some 0x0000000000000001
parse_float | "0." | some 0x0000000000000001
parse_float | "-0." | some 0x8000000000000001
