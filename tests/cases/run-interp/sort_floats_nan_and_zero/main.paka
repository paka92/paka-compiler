enum Msg { Start }

fn update(m: Msg) -> List<Effect<Msg>> {
  var xs = [2.0, 0.0 / 0.0, 1.0]
  sort(&xs)
  var zeros = [0.0, -0.0, 0.0]
  sort(&zeros)
  let kept = "{xs[0] == 2.0} {xs[1] == xs[1]} {xs[2] == 1.0}"
  let signs = "{1.0 / zeros[0] < 0.0} {1.0 / zeros[1] < 0.0} {1.0 / zeros[2] < 0.0}"
  [Print("{kept} {signs}"), Exit]
}

app generics {
  start: Start
  update: update
  grants: [Console]
}
