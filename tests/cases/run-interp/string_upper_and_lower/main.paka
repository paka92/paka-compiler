enum Msg { Start }

fn n(i: Int) -> String { "{i}" }

fn t(b: Bool) -> String { "{b}" }

fn q(x: String) -> String { "[" + x + "]" }

fn opt(o: Option<Int>) -> String {
  match o {
    Some(i) => "{i}"
    None => "none"
  }
}

fn lst(xs: List<String>) -> String {
  let body = join(xs, "|")
  "{len(xs)}[{body}]"
}

fn update(m: Msg) -> List<Effect<Msg>> {
  [
    Print(q(upper("élan")) + q(upper("")) + q(upper("hello 日本")) + q(upper("ß"))),
    Print(q(lower("ÉLAN Ab")) + q(lower("Hello")) + q(lower(""))),
    Exit
  ]
}

app rows {
  start: Start
  update: update
  grants: [Console]
}
