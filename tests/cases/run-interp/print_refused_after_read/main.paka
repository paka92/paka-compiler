enum Msg { Start, Loaded(text: String), Failed(why: String) }

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start => [ReadFile("main.paka", then: Loaded, or: Failed)]
    Loaded(text) => [Print("read"), Exit]
    Failed(why) => [Exit]
  }
}

app reader {
  start: Start
  update: update
  grants: [ReadFiles]
}
