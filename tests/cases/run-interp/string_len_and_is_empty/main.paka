enum Msg { Start }

fn n(i: Int) -> String { "{i}" }

fn t(b: Bool) -> String { "{b}" }

fn q(x: String) -> String { "[" + x + "]" }

fn opt(o: Option<Int>) -> String {
  match o {
    Some(i) => "{i}"
    None => "none"
  }
}

fn lst(xs: List<String>) -> String {
  let body = join(xs, "|")
  "{len(xs)}[{body}]"
}

fn update(m: Msg) -> List<Effect<Msg>> {
  [
    Print(n(len("hello")) + " " + n(len("")) + " " + n(len("héllo")) + " " + n(len("日本語")) + " " + n(len("😀"))),
    Print(t(is_empty("")) + " " + t(is_empty("a")) + " " + t(is_empty("é"))),
    Exit
  ]
}

app rows {
  start: Start
  update: update
  grants: [Console]
}
