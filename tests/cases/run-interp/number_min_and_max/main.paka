enum Msg { Start }

fn n(i: Int) -> String { "{i}" }

fn t(b: Bool) -> String { "{b}" }

fn q(x: String) -> String { "[" + x + "]" }

fn opt(o: Option<Int>) -> String {
  match o {
    Some(i) => "{i}"
    None => "none"
  }
}

fn lst(xs: List<String>) -> String {
  let body = join(xs, "|")
  "{len(xs)}[{body}]"
}

fn f(x: Float) -> String { fixed(x, digits: 1) }

fn update(m: Msg) -> List<Effect<Msg>> {
  [
    Print(n(min(3, 5)) + " " + n(max(3, 5)) + " " + n(min(-2, -7)) + " " + n(max(-2, -7)) + " " + n(min(4, 4))),
    Print(f(min(1.5, 2.5)) + " " + f(max(1.5, 2.5)) + " " + f(min(-0.5, 0.25)) + " " + f(max(-1.0, -3.0))),
    Exit
  ]
}

app rows {
  start: Start
  update: update
  grants: [Console]
}
