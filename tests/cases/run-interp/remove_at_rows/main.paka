enum Msg { Start }

fn update(q: Msg) -> List<Effect<Msg>> {
  var xs = [1, 2, 3, 4, 5]
  let a = remove_at(&xs, 0)
  let b = remove_at(&xs, 3)
  let c = remove_at(&xs, 1)
  var one = ["x"]
  let d = remove_at(&one, 0)
  [Print("{a} {b} {c} {d} {len(xs)} {xs[0]} {xs[1]} {is_empty(one)}"), Exit]
}

app generics {
  start: Start
  update: update
  grants: [Console]
}
