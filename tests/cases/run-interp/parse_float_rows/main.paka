enum Msg { Start }

fn n(i: Int) -> String { "{i}" }

fn t(b: Bool) -> String { "{b}" }

fn q(x: String) -> String { "[" + x + "]" }

fn opt(o: Option<Int>) -> String {
  match o {
    Some(i) => "{i}"
    None => "none"
  }
}

fn lst(xs: List<String>) -> String {
  let body = join(xs, "|")
  "{len(xs)}[{body}]"
}

fn show(o: Option<Float>) -> String {
  match o {
    Some(x) => fixed(x, digits: 3)
    None => "none"
  }
}

fn update(m: Msg) -> List<Effect<Msg>> {
  [
    Print(show(parse_float("7")) + " " + show(parse_float("3.14")) + " " + show(parse_float("-0.5")) + " " + show(parse_float("0.1"))),
    Print(show(parse_float("007.50")) + " " + show(parse_float("-0"))),
    Print(show(parse_float("")) + " " + show(parse_float("1e3")) + " " + show(parse_float(".5")) + " " + show(parse_float("1.")) + " " + show(parse_float("1,5"))),
    Print(show(parse_float(" 1")) + " " + show(parse_float("inf")) + " " + show(parse_float("NaN")) + " " + show(parse_float("٣"))),
    Exit
  ]
}

app rows {
  start: Start
  update: update
  grants: [Console]
}
