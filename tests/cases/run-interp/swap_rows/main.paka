enum Msg { Start }

fn update(q: Msg) -> List<Effect<Msg>> {
  var xs = [1, 2, 3, 4]
  swap(&xs, 0, 3)
  swap(&xs, 1, 1)
  swap(&xs, 2, 1)
  var one = [7]
  swap(&one, 0, 0)
  [Print("{xs[0]} {xs[1]} {xs[2]} {xs[3]} {one[0]}"), Exit]
}

app generics {
  start: Start
  update: update
  grants: [Console]
}
