enum Msg { Start }

fn update(q: Msg) -> List<Effect<Msg>> {
  let a = list_of(7, count: 3)
  let none = list_of("x", count: 0)
  let words = list_of("ab", count: 2)
  var grid = list_of(list_of(0, count: 2), count: 2)
  grid[0][1] = 5
  [Print("{len(a)} {a[0]}{a[2]} {len(none)} {words[1]} {grid[0][1]} {grid[1][1]}"), Exit]
}

app generics {
  start: Start
  update: update
  grants: [Console]
}
