enum Msg { Start }

fn update(q: Msg) -> List<Effect<Msg>> {
  var even = [1, 2, 3, 4]
  var odd = ["a", "b", "c"]
  var one = [9]
  var none: List<Int> = []
  reverse(&even)
  reverse(&odd)
  reverse(&one)
  reverse(&none)
  [
    Print("{even[0]}{even[1]}{even[2]}{even[3]} {odd[0]}{odd[1]}{odd[2]} {one[0]} {len(none)}"),
    Exit
  ]
}

app generics {
  start: Start
  update: update
  grants: [Console]
}
