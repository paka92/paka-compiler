enum Msg { Start }

fn min_path(g: List<List<Int>>) -> Int {
  var best = list_of(list_of(0, count: len(g[0])), count: len(g))
  for r in 0..<len(g) {
    for c in 0..<len(g[0]) {
      var from = 0
      if r > 0 && c > 0 {
        from = min(best[r - 1][c], best[r][c - 1])
      } else if r > 0 {
        from = best[r - 1][c]
      } else if c > 0 {
        from = best[r][c - 1]
      }
      best[r][c] = g[r][c] + from
    }
  }
  best[len(g) - 1][len(g[0]) - 1]
}

fn update(q: Msg) -> List<Effect<Msg>> {
  let g = [[1, 3, 1], [1, 5, 1], [4, 2, 1]]
  [Print("{min_path(g)}"), Exit]
}

app generics {
  start: Start
  update: update
  grants: [Console]
}
