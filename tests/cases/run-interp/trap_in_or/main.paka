enum Msg { Start, Loaded(text: String), Failed(why: String) }

fn boom(why: String) -> Msg {
  Failed("{1 / 0}")
}

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start => [Print("asking"), ReadFile("missing.txt", then: Loaded, or: boom), Print("asked")]
    Loaded(text) => [Print("read"), Exit]
    Failed(why) => [Print("cannot read: {why}"), ExitWith(20)]
  }
}

app reader {
  start: Start
  update: update
  grants: [Console, ReadFiles]
}
