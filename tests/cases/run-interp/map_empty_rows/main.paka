enum Msg { Start }

fn update(q: Msg) -> List<Effect<Msg>> {
  let m: Map<String, Int> = [:]
  let absent = has(m, "k")
  let got = unwrap_or(get(m, "k"), -1)
  [Print("{len(m)} {is_empty(m)} {absent} {got} {len(keys(m))} {len(values(m))}"), Exit]
}

app generics {
  start: Start
  update: update
  grants: [Console]
}
