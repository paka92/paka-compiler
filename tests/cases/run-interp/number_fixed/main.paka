enum Msg { Start }

fn n(i: Int) -> String { "{i}" }

fn t(b: Bool) -> String { "{b}" }

fn q(x: String) -> String { "[" + x + "]" }

fn opt(o: Option<Int>) -> String {
  match o {
    Some(i) => "{i}"
    None => "none"
  }
}

fn lst(xs: List<String>) -> String {
  let body = join(xs, "|")
  "{len(xs)}[{body}]"
}

fn update(m: Msg) -> List<Effect<Msg>> {
  [
    Print(fixed(3.14159, digits: 2) + " " + fixed(2.5, digits: 0) + " " + fixed(-2.5, digits: 0) + " " + fixed(0.125, digits: 2) + " " + fixed(1.005, digits: 2)),
    Print(fixed(0.0, digits: 0) + " " + fixed(100.0 / 3.0, digits: 2) + " " + fixed(-0.001, digits: 2) + " " + fixed(0.1, digits: 20)),
    Print(fixed(0.0 / 0.0, digits: 3) + " " + fixed(1.0 / 0.0, digits: 3) + " " + fixed(-1.0 / 0.0, digits: 3)),
    Exit
  ]
}

app rows {
  start: Start
  update: update
  grants: [Console]
}
