enum Msg { Start }

fn update(q: Msg) -> List<Effect<Msg>> {
  let xs = [1, 2, 3]
  let none: List<String> = []
  let m = ["a": 1, "b": 2]
  let nomap: Map<Int, Int> = [:]
  let rows = [[1], []]
  [
    Print("{len(xs)} {len(none)} {len(m)} {len(nomap)} {len(rows)} {len(rows[1])}"),
    Print("{is_empty(xs)} {is_empty(none)} {is_empty(m)} {is_empty(nomap)} {is_empty(rows[1])}"),
    Exit
  ]
}

app generics {
  start: Start
  update: update
  grants: [Console]
}
