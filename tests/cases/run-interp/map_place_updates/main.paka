enum Msg { Start }

fn update(q: Msg) -> List<Effect<Msg>> {
  var m: Map<String, List<Int>> = ["a": [1]]
  append(&m["a"], 2)
  m["a"][0] = 9
  m["b"] = []
  append(&m["b"], 4)
  var c: Map<String, Map<String, Int>> = ["x": [:]]
  c["x"]["y"] = 1
  c["x"]["y"] += 4
  c["z"] = ["w": 2]
  let a = m["a"]
  let b = m["b"]
  let y = c["x"]["y"]
  let w = c["z"]["w"]
  [Print("{len(a)} {a[0]} {a[1]} {len(b)} {b[0]} {y} {w} {len(c)}"), Exit]
}

app generics {
  start: Start
  update: update
  grants: [Console]
}
