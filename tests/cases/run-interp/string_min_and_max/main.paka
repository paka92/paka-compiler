enum Msg { Start }

fn n(i: Int) -> String { "{i}" }

fn t(b: Bool) -> String { "{b}" }

fn q(x: String) -> String { "[" + x + "]" }

fn opt(o: Option<Int>) -> String {
  match o {
    Some(i) => "{i}"
    None => "none"
  }
}

fn lst(xs: List<String>) -> String {
  let body = join(xs, "|")
  "{len(xs)}[{body}]"
}

fn update(m: Msg) -> List<Effect<Msg>> {
  [
    Print(q(min("b", "a")) + q(max("b", "a")) + q(min("", "a")) + q(max("", "a"))),
    Print(q(min("é", "z")) + q(max("é", "z")) + q(min("日", "本")) + q(max("日", "本"))),
    Print(q(min("ab", "abc")) + q(max("ab", "abc")) + q(min("a", "a"))),
    Exit
  ]
}

app rows {
  start: Start
  update: update
  grants: [Console]
}
