enum Msg { Start }

fn update(q: Msg) -> List<Effect<Msg>> {
  var m: Map<Int, String> = [3: "c", 1: "a", 2: "b"]
  var order = 0
  for k in keys(m) {
    order = order * 10 + k
    remove(&m, k)
    if k == 1 {
      remove(&m, 3)
      m[7] = "g"
    }
  }
  var grown: Map<Int, Int> = [1: 0, 2: 0]
  var visits = 0
  for k in keys(grown) {
    grown[k + 10] = k
    visits += 1
  }
  let ks = keys(grown)
  [
    Print("{order} {len(m)} {m[7]}"),
    Print("{visits} {len(grown)} {ks[0]} {ks[1]} {ks[2]} {ks[3]}"),
    Exit
  ]
}

app generics {
  start: Start
  update: update
  grants: [Console]
}
