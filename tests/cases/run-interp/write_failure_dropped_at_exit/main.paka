enum Msg { Start, Saved, Failed(why: String) }

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start => [WriteFile("no_such_dir/out.txt", "text", then: Saved, or: Failed), Print("done"), Exit]
    Saved => [Print("saved"), ExitWith(20)]
    Failed(why) => [Print("cannot write: {why}"), ExitWith(20)]
  }
}

app writer {
  start: Start
  update: update
  grants: [Console, WriteFiles]
}
