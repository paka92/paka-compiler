enum Msg { Start }

fn n(i: Int) -> String { "{i}" }

fn t(b: Bool) -> String { "{b}" }

fn q(x: String) -> String { "[" + x + "]" }

fn opt(o: Option<Int>) -> String {
  match o {
    Some(i) => "{i}"
    None => "none"
  }
}

fn lst(xs: List<String>) -> String {
  let body = join(xs, "|")
  "{len(xs)}[{body}]"
}

fn update(m: Msg) -> List<Effect<Msg>> {
  [
    Print(lst(split("a,b,c", ","))),
    Print(lst(split("a,,b", ","))),
    Print(lst(split(",", ","))),
    Print(lst(split("", ","))),
    Print(lst(split("ab", "abc"))),
    Print(lst(split("aaa", "aa"))),
    Print(lst(split("", ""))),
    Print(lst(split("abc", ""))),
    Print(lst(split("é,日", ","))),
    Print(lst(split("a→b", "→"))),
    Exit
  ]
}

app rows {
  start: Start
  update: update
  grants: [Console]
}
