enum Msg { Start, Loaded(text: String), Failed(why: String) }

fn down(n: Int) -> Int { down(n + 1) + 1 }

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start => [Print("before"), ReadFile("main.paka", then: Loaded, or: Failed)]
    Loaded(text) => [Print("{down(0)}"), Exit]
    Failed(why) => [Exit]
  }
}

app apps {
  start: Start
  update: update
  grants: [Console, ReadFiles]
}
