enum Msg { Start, Loaded(text: String), Failed(why: String) }

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start => [Print("before"), ReadFile("main.paka", then: Loaded, or: Failed), Exit]
    Loaded(text) => [Print("loaded"), Exit]
    Failed(why) => [Print("failed"), Exit]
  }
}

app apps {
  start: Start
  update: update
  grants: [Console, ReadFiles, WriteFiles]
}
