enum Msg { Start, Loaded(text: String), Failed(why: String) }

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start => [ReadFile("main.paka", then: Loaded, or: Failed), Print("first")]
    Loaded(text) => [Print("second"), Exit]
    Failed(why) => [ExitWith(20)]
  }
}

app apps {
  start: Start
  update: update
  grants: [Console, ReadFiles]
}
