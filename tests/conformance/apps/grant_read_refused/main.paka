enum Msg { Start, Loaded(text: String), Failed(why: String), Saved }

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start => [Print("a"), ReadFile("main.paka", then: Loaded, or: Failed), Print("b")]
    Loaded(text) => [Print("loaded"), Exit]
    Failed(why) => [Print("failed"), Exit]
    Saved => [Exit]
  }
}

app apps {
  start: Start
  update: update
  grants: [Console]
}
