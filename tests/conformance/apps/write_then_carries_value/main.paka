enum Msg { Start, Saved(name: String), Failed(why: String) }

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start => [WriteFile("out.txt", "x", then: Saved("out.txt"), or: Failed)]
    Saved(name) => [Print("saved {name}"), Exit]
    Failed(why) => [Print("failed: {why}"), ExitWith(20)]
  }
}

app apps {
  start: Start
  update: update
  grants: [Console, ReadFiles, WriteFiles]
}
