enum Msg { Start, Loaded(text: String), Failed(why: String), Saved }

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start => [ReadFile("main.paka", then: Loaded, or: Failed)]
    Loaded(text) => [Print("loaded"), WriteFile("out.txt", "text", then: Saved, or: Failed)]
    Failed(why) => [Print("failed"), Exit]
    Saved => [Print("saved"), Exit]
  }
}

app apps {
  start: Start
  update: update
  grants: [Console, ReadFiles]
}
