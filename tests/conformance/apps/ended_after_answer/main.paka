enum Msg { Start, Loaded(text: String), Failed(why: String) }

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start => [ReadFile("main.paka", then: Loaded, or: Failed)]
    Loaded(text) => [Print("got it")]
    Failed(why) => [Print("failed")]
  }
}

app apps {
  start: Start
  update: update
  grants: [Console, ReadFiles, WriteFiles]
}
