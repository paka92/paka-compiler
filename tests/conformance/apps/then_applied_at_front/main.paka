enum Msg { Start, Loaded(text: String), Failed(why: String) }

fn boom(text: String) -> Msg {
  let z = len(text) - len(text)
  let r = 7 / z
  Loaded("never")
}

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start => [ReadFile("main.paka", then: boom, or: Failed), Print("asked")]
    Loaded(text) => [Exit]
    Failed(why) => [Exit]
  }
}

app apps {
  start: Start
  update: update
  grants: [Console, ReadFiles]
}
