enum Msg { Start }

fn show(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ", ") + "]"
}

fn ahead(a: Int, b: Int) -> Bool { a > b }

fn update(msg: Msg) -> List<Effect<Msg>> {
  var xs = [3, 1, 2, 5, 4]
  sort_by(&xs, ahead)
  [Print(show(xs)), Exit]
}

app types {
  start: Start
  update: update
  grants: [Console]
}
