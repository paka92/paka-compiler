enum Msg { Start }

enum Shape { Dot, Circle(r: Float), Rect(w: Float, h: Float) }

fn area(s: Shape) -> Float {
  match s {
    Dot => 0.0
    Circle(r) => r * r * 3.0
    Rect(w, h) => w * h
  }
}

fn wide(s: Shape) -> Float {
  match s {
    Dot => 0.0
    Circle(_) => 0.0
    Rect(w, _) => w
  }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let a = fixed(area(Dot), digits: 1)
  let b = fixed(area(Circle(2.0)), digits: 1)
  let c = fixed(area(Rect(2.0, 3.5)), digits: 1)
  let d = fixed(wide(Rect(2.0, 3.5)), digits: 1)
  [Print("{a} {b} {c} {d}"), Exit]
}

app types {
  start: Start
  update: update
  grants: [Console]
}
