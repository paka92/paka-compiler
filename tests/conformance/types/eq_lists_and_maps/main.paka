enum Msg { Start }

fn update(msg: Msg) -> List<Effect<Msg>> {
  let a = [1, 2] == [1, 2]
  let b = [1, 2] == [2, 1]
  let c = [1] == [1, 1]
  let d = ["a": 1, "b": 2] == ["b": 2, "a": 1]
  let e = ["a": 1] == ["a": 2]
  let f = [[1], []] == [[1], []]
  [Print("{a} {b} {c} {d} {e} {f}"), Exit]
}

app types {
  start: Start
  update: update
  grants: [Console]
}
