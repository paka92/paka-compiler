enum Msg { Start }

enum Part { Plain(t: String), Gap }

fn merge(target: inout String, t: String) -> Result<Int, String> {
  if t == "" {
    return Err("empty part")
  }
  target += t
  Ok(len(t))
}

fn glue(parts: List<Part>) -> Result<String, String> {
  var out = ""
  var gaps = 0
  for p in parts {
    match p {
      Plain(t) => _ = merge(&out, t)?
      Gap => gaps += 1
    }
  }
  Ok("{out}/{gaps}")
}

fn show(r: Result<String, String>) -> String {
  match r {
    Ok(s) => s
    Err(e) => "error: {e}"
  }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let a = show(glue([Plain("ab"), Gap, Plain("c")]))
  let b = show(glue([Plain("ab"), Plain(""), Gap]))
  [Print("{a} {b}"), Exit]
}

app types {
  start: Start
  update: update
  grants: [Console]
}
