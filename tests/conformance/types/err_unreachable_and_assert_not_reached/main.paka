enum Msg { Start }

fn sign_name(n: Int) -> String {
  assert(n >= -1 && n <= 1)
  match n {
    -1 => "minus"
    0 => "zero"
    1 => "plus"
    _ => unreachable()
  }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  [Print(sign_name(-1) + " " + sign_name(0) + " " + sign_name(1)), Exit]
}

app types {
  start: Start
  update: update
  grants: [Console]
}
