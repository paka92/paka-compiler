enum Msg { Start }

fn update(msg: Msg) -> List<Effect<Msg>> {
  let nan = 0.0 / 0.0
  let zero = 0.0
  let neg = -zero
  let a = nan == nan
  let b = nan != nan
  let c = neg == zero
  let d = nan < 1.0 || nan > 1.0 || nan <= nan
  [Print("{a} {b} {c} {d}"), Exit]
}

app types {
  start: Start
  update: update
  grants: [Console]
}
