enum Msg { Start }

fn pick(go: Bool) -> Result<Option<Int>, Float> {
  Ok(if go { None } else { ??later })
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let early = pick(true)
  let late = pick(false)
  [Print("not reached"), Exit]
}

app types {
  start: Start
  update: update
  grants: [Console]
}
