enum Msg { Start }

fn made(go: Bool) -> Result<List<Int>, String> {
  if go { Ok([??later]) } else { Ok([1]) }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let early = made(false)
  let late = made(true)
  [Print("not reached"), Exit]
}

app types {
  start: Start
  update: update
  grants: [Console]
}
