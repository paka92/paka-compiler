enum Msg { Start }

fn made() -> Int {
  let xs: List<List<Int>> = [[], [], [100]]
  len(xs)
}

fn early() -> Option<Int> {
  let xs: List<List<Int>> = [[], [], (get(["b": [7]], "a"))?]
  Some(len(xs))
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let n = made()
  let e = early()
  [Print("{n}"), Print("{unwrap_or(e, -1)}"), Exit]
}

app lists {
  start: Start
  update: update
  grants: [Console]
}
