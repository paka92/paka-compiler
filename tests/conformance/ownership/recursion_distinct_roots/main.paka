enum Msg { Start }

fn show(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ", ") + "]"
}

fn fill(xs: inout List<Int>, ys: List<Int>, n: Int) {
  if n > 0 {
    append(&xs, ys[0])
    fill(&xs, ys, n - 1)
  }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var xs = [0]
  let ys = [4]
  fill(&xs, ys, 3)
  [Print("{show(xs)}"), Exit]
}

app ownership {
  start: Start
  update: update
  grants: [Console]
}
