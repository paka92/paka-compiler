enum Msg { Start }

fn total(xs: List<Int>) -> Int {
  var sum = 0
  for x in xs { sum += x }
  sum
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var xs = [1, 2, 3, 4]
  var part = xs[1..<3]
  append(&part, 10)
  xs[1] = 20
  let s = total(xs[0..<2])
  let text = "abcd"
  let piece = text[1..<3]
  [Print("{len(xs)} {total(part)} {s} {piece} {part[0]}"), Exit]
}

app ownership {
  start: Start
  update: update
  grants: [Console]
}
