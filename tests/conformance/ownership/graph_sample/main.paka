enum Msg { Start }

type Graph { adj: List<List<Int>> = [] }
fn add_node(g: inout Graph) -> Int {
  append(&g.adj, [])
  len(g.adj) - 1
}
fn link(g: inout Graph, a: Int, b: Int) { append(&g.adj[a], b) }
fn unlink(g: inout Graph, a: Int, b: Int) {
  var i = 0
  while i < len(g.adj[a]) {
    if g.adj[a][i] == b { _ = remove_at(&g.adj[a], i) } else { i = i + 1 }
  }
}
fn reach(g: Graph, seen: inout List<Bool>, u: Int) {
  seen[u] = true
  for v in g.adj[u] { if !seen[v] { reach(g, &seen, v) } }
}
example graph_sample {
  var g = Graph {}
  let a = add_node(&g)
  let b = add_node(&g)
  link(&g, a, b)
  var seen: List<Bool> = list_of(false, count: 2)
  reach(g, &seen, a)
  unlink(&g, a, b)
  seen[b] && len(g.adj[a]) == 0
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var g = Graph {}
  let a = add_node(&g)
  let b = add_node(&g)
  link(&g, a, b)
  var seen: List<Bool> = list_of(false, count: 2)
  reach(g, &seen, a)
  unlink(&g, a, b)
  let after_unlink = len(g.adj[a])
  link(&g, a, b)
  link(&g, g.adj[a][0], b)
  [Print("{seen[b]} {after_unlink} {len(g.adj[a])} {len(g.adj[b])}"), Exit]
}

app ownership {
  start: Start
  update: update
  grants: [Console]
}
