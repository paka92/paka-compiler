enum Msg { Start }

fn show(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ", ") + "]"
}

fn next_of(x: Int) -> Int {
  x * 2
}

fn bfs(adj: List<List<Int>>, index: Map<String, Int>, start: String) -> List<Int> {
  var seen = list_of(false, count: len(adj))
  var q = [index[start]]
  seen[q[0]] = true
  var i = 0
  while i < len(q) {
    for v in adj[q[i]] {
      if !seen[v] {
        seen[v] = true
        append(&q, v)
      }
    }
    i += 1
  }
  q
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var q = [1]
  var i = 0
  while i < len(q) {
    let x = q[i]
    i += 1
    if x < 8 { append(&q, next_of(x)) }
  }
  let adj: List<List<Int>> = [[1, 2], [3], [3], []]
  let index = ["a": 0, "b": 1]
  let order = bfs(adj, index, "a")
  [Print("{show(q)} {show(order)}"), Exit]
}

app ownership {
  start: Start
  update: update
  grants: [Console]
}
