// A trap while a variant's fields are made leaves nothing behind: the fields made so far and
// the variant's block are dropped.

enum Msg { Start }

enum Tree { Leaf, Node(left: Tree, label: String, right: Tree) }

fn tree(d: Int) -> Tree {
  if d == 0 { Leaf } else { Node(tree(d - 1), "n{d}", tree(d - 1)) }
}

fn pick(xs: List<Int>, i: Int) -> Tree {
  Node(tree(2), "x", Node(tree(1), "{xs[i]}", Leaf))
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let ok = pick([1, 2], 1)
  let bad = pick([1], 3)
  [Print("unreached"), Exit]
}

app traps {
  start: Start
  update: update
  grants: [Console]
}
