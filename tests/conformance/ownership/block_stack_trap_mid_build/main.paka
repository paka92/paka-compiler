// Building a chain by recursion without end traps stack while each link waits for the next;
// every block made by then is freed.

enum Msg { Start }

enum Chain { End, Link(text: String, next: Chain) }

fn grow(n: Int) -> Chain {
  Link("link {n}", grow(n + 1))
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let c = grow(0)
  [Print("unreached"), Exit]
}

app deep {
  start: Start
  update: update
  grants: [Console]
}
