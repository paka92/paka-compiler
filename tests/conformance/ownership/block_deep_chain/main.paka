// A long chain, a variant block per link, is walked by recursion, copied, compared and dropped.

enum Msg { Start }

enum Chain { End, Link(n: Int, next: Chain) }

fn chain(n: Int) -> Chain {
  var c = End
  for i in 0..<n { c = Link(i, c) }
  c
}

fn sum(c: Chain) -> Int {
  match c {
    End => 0
    Link(n, next) => n + sum(next)
  }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let a = chain(2000)
  var b = a
  let same = a == b
  b = Link(7, b)
  let kept = [a, b, End]
  [Print("{sum(a)} {sum(kept[1])} {same} {a == b} {len(kept)}"), Exit]
}

app deep {
  start: Start
  update: update
  grants: [Console]
}
