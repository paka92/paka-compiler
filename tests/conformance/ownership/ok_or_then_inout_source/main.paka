enum Msg { Start }

fn clear(t: inout String) -> String {
  t = "zz"
  "x"
}

fn reset(o: inout Option<String>) -> String {
  o = None
  ""
}

fn fill(n: Int) -> String { repeat("q", n) }

fn show(r: Result<String, String>, x: String, pad: String) -> String {
  match r {
    Ok(v) => "ok {len(v)} {v[0..<6]}{x}{len(pad)}"
    Err(e) => "err {e}{x}{len(pad)}"
  }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var s = repeat("e", 3)
  let none: Option<String> = None
  let a = show(ok_or(none, s), clear(&s), fill(3))
  var o: Option<String> = Some(repeat("abc", 1000))
  let b = show(ok_or(o, s), reset(&o), fill(3000))
  [Print(a), Print(b), Print(s), Exit]
}

app ownership {
  start: Start
  update: update
  grants: [Console]
}
