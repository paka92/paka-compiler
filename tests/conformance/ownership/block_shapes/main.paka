// Recursive enums of several shapes, a variant's fields in one block, held in lists, maps,
// records and Options, copied, changed and compared.

enum Msg { Start }

enum Tree { Leaf, Node(left: Tree, value: Int, right: Tree) }

enum Expr { Num(n: Int), Neg(e: Option<Expr>), Add(a: Expr, b: Expr), Named(name: String, body: Expr) }

enum Chain { End, Link(text: String, next: Chain) }

type Holder { e: Expr, label: String }

enum Mixed { Hold(h: Holder), Pair(m: Mixed, tags: List<String>), Done }

enum Ring { One(r: RingBox), Stop }

type RingBox { inner: Ring, n: Int }

enum Forest { Grove(trees: List<Forest>), Seed(n: Int) }

enum Book { Shelf(kids: Map<String, Book>), Page(text: String) }

fn tree(d: Int) -> Tree {
  if d == 0 { Leaf } else { Node(tree(d - 1), d, tree(d - 1)) }
}

fn total(t: Tree) -> Int {
  match t {
    Leaf => 0
    Node(l, v, r) => total(l) + v + total(r)
  }
}

fn eval(e: Expr) -> Int {
  match e {
    Num(n) => n
    Neg(inner) => match inner {
      Some(x) => 0 - eval(x)
      None => 0
    }
    Add(a, b) => eval(a) + eval(b)
    Named(name, body) => eval(body) + len(name)
  }
}

fn chain(n: Int) -> Chain {
  var c = End
  for i in 0..<n { c = Link("w{i}", c) }
  c
}

fn show(t: Tree) -> String {
  match t {
    Leaf => "."
    Node(l, v, r) => "({show(l)} {v} {show(r)})"
  }
}

fn text(e: Expr) -> String {
  match e {
    Num(n) => "{n}"
    Neg(inner) => match inner {
      Some(x) => "-{text(x)}"
      None => "-?"
    }
    Add(a, b) => "({text(a)} + {text(b)})"
    Named(name, body) => "{name}={text(body)}"
  }
}

fn links(c: Chain) -> String {
  match c {
    End => "end"
    Link(w, next) => "{w}>{links(next)}"
  }
}

fn mixed(m: Mixed) -> String {
  match m {
    Hold(h) => "{h.label}:{text(h.e)}"
    Pair(inner, tags) => "[{mixed(inner)} {len(tags)}]"
    Done => "done"
  }
}

fn ring(r: Ring) -> Int {
  match r {
    One(b) => b.n * 10 + ring(b.inner)
    Stop => 0
  }
}

fn forest(f: Forest) -> Int {
  match f {
    Grove(ts) => {
      var s = 100
      for t in ts { s += forest(t) }
      s
    }
    Seed(n) => n
  }
}

fn book(b: Book) -> Int {
  match b {
    Shelf(kids) => {
      var s = 0
      for k in keys(kids) { s += book(kids[k]) }
      s
    }
    Page(text) => len(text)
  }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let t = tree(3)
  var u = t
  u = Node(u, 100, Leaf)
  let e = Add(Named("abc", Neg(Some(Num(5)))), Add(Num(1), Neg(None)))
  let f = e
  let c = chain(3)
  let m = Pair(Pair(Hold(Holder { e: Num(7), label: "h" }), ["x"]), ["y", "z"])
  let r = One(RingBox { inner: One(RingBox { inner: Stop, n: 2 }), n: 1 })
  let g = Grove([Seed(1), Grove([Seed(2), Grove([])])])
  let b = Shelf(["a": Page("one"), "b": Shelf(["c": Page("two")])])
  var trees = [t, Leaf, Node(Leaf, 9, Leaf)]
  trees[1] = u
  let byname = ["t": u, "l": Leaf]
  let named = total(byname["t"])
  var sum = 0
  for x in trees { sum += total(x) }
  [
    Print("{total(t)} {total(u)} {eval(e)} {e == f} {t == u} {sum} {named}"),
    Print(show(u)),
    Print(text(e)),
    Print(links(c)),
    Print(mixed(m)),
    Print("{ring(r)} {forest(g)} {book(b)}"),
    Exit
  ]
}

app ownership {
  start: Start
  update: update
  grants: [Console]
}
