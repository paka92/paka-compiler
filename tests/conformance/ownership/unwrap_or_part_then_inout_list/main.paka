enum Msg { Start }

fn empty(xs: inout List<Option<String>>) -> String {
  xs = []
  for i in 0..<100 { append(&xs, Some(repeat("w", i))) }
  ""
}

fn fill(n: Int) -> String { repeat("q", n) }

fn update(msg: Msg) -> List<Effect<Msg>> {
  let s = "fallback"
  var xs: List<Option<String>> = [Some(repeat("abc", 1000))]
  let joined = "{2}{unwrap_or(xs[0], s)}{empty(&xs)}{fill(3000)}"
  [Print("{len(joined)} {len(xs)}"), Print(joined[0..<10]), Exit]
}

app ownership {
  start: Start
  update: update
  grants: [Console]
}
