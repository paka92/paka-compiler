// A trap in an arm before the local it reads last moves: nothing is dropped after it.

enum Msg { Start }

fn pick(xs: List<Int>, i: Int, s: String) -> String {
  let t = s + "!"
  if i > 0 {
    "{xs[i]}" + t
  } else {
    t
  }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let a = pick([1, 2], 1, "a")
  let b = pick([1], 0, "b")
  let c = pick([1], 5, a + b)
  [Print(c), Exit]
}

app traps {
  start: Start
  update: update
  grants: [Console]
}
