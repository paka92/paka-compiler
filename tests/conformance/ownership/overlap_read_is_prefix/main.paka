enum Msg { Start }

type Pair { left: List<Int> = [], right: List<Int> = [] }

fn absorb(xs: inout List<Int>, p: Pair) {
  for x in p.right { append(&xs, x) }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var p = Pair { left: [1], right: [2] }
  absorb(&p.left, p)
  [Print("done"), Exit]
}

app ownership {
  start: Start
  update: update
  grants: [Console]
}
