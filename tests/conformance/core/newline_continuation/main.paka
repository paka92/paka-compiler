enum Msg { Start }

fn pair(a: Int, b: Int) -> Int { a + b }

fn update(msg: Msg) -> List<Effect<Msg>> {
  let a = 1 +
    2
  let b =
    a * 3
  let c = pair(
    a,
    b
  )
  let xs = [
    a,
    b,
    c
  ]
  let ok = a == 3 &&
    b == 9
  let word = match a {
    1 |
    3 =>
      "odd"
    _ => "other"
  }
  [
    Print("{a} {b} {c} {xs[2]} {ok} {word}"),
    Exit
  ]
}

app core {
  start: Start
  update: update
  grants: [Console]
}
