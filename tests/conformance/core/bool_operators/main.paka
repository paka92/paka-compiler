enum Msg { Start }

fn update(msg: Msg) -> List<Effect<Msg>> {
  let t = true
  let f = false
  [
    Print("{!t} {!f} {!!t}"),
    Print("{t && t} {t && f} {f && t} {f && f}"),
    Print("{t || t} {t || f} {f || t} {f || f}"),
    Print("{!f && f} {f || t && f} {t || f && f}"),
    Print("{t == t} {t != f} {f == t}"),
    Exit
  ]
}

app core {
  start: Start
  update: update
  grants: [Console]
}
