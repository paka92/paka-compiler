enum Msg { Start }

fn update(msg: Msg) -> List<Effect<Msg>> {
  let word = "café"
  let kanji = "日本語"
  [
    Print("{word} {len(word)}"),
    Print("{kanji} {len(kanji)}"),
    Print(kanji[1]),
    Print(kanji[1..<3]),
    Print(word[3]),
    Exit
  ]
}

app core {
  start: Start
  update: update
  grants: [Console]
}
