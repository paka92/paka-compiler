enum Msg { Start }

fn first_big(xs: List<Int>) -> Int {
  for x in xs {
    match x > 10 {
      true => {
        return x
      }
      false => {}
    }
  }
  -1
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let r1 = first_big([1, 20, 30])
  let r2 = first_big([3, 4])
  [
    Print("{r1} {r2}"),
    Exit
  ]
}

app core {
  start: Start
  update: update
  grants: [Console]
}
