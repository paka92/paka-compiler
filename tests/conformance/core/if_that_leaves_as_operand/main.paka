enum Msg { Start }

type Pair { a: Int, b: Int }

fn sum(c: Bool) -> Int {
  if c {
    return 1
  }
  2 + (if c { unreachable() } else { unreachable() })
}

fn pair(n: Int) -> Pair {
  if n > 0 {
    return Pair { a: n, b: n }
  }
  Pair { a: 0, b: match n { _ => unreachable() } }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let p = pair(4)
  [Print("{sum(true)}"), Print("{p.a + p.b}"), Exit]
}

app core {
  start: Start
  update: update
  grants: [Console]
}
