enum Msg { Start }

fn find_first_even(xs: List<Int>) -> Int {
  for x in xs {
    if x % 2 == 0 { return x }
  }
  0
}

fn bump_to(n: inout Int, limit: Int) {
  if n >= limit {
    return
  }
  n += 1
}

fn first_square_over(limit: Int) -> Int {
  var i = 0
  while true {
    if i * i > limit { return i }
    i += 1
  }
  0
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let e1 = find_first_even([3, 5, 8, 10])
  let e2 = find_first_even([1, 3])
  var c = 0
  bump_to(&c, 2)
  bump_to(&c, 2)
  bump_to(&c, 2)
  [
    Print("{e1} {e2}"),
    Print("{c}"),
    Print("{first_square_over(50)}"),
    Exit
  ]
}

app core {
  start: Start
  update: update
  grants: [Console]
}
