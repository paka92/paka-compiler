enum Msg { Start }

fn update(msg: Msg) -> List<Effect<Msg>> {
  [
    Print(fixed(0.125, digits: 2)),
    Print(fixed(2.5, digits: 0)),
    Print(fixed(-2.5, digits: 0)),
    Print(fixed(1.005, digits: 2)),
    Print(fixed(2.675, digits: 2)),
    Print(fixed(0.49999999999999994, digits: 0)),
    Print(fixed(-0.001, digits: 2)),
    Print(fixed(0.0, digits: 0)),
    Print(fixed(100.0 / 3.0, digits: 2)),
    Exit
  ]
}

app core {
  start: Start
  update: update
  grants: [Console]
}
