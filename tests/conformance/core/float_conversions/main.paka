enum Msg { Start }

fn update(msg: Msg) -> List<Effect<Msg>> {
  [
    Print(fixed(to_float(7), digits: 1)),
    Print("{to_int(2.9)} {to_int(-2.9)} {to_int(-0.9)}"),
    Print("{to_int(-9223372036854775808.0)}"),
    Print(fixed(to_float(9007199254740993), digits: 0)),
    Exit
  ]
}

app core {
  start: Start
  update: update
  grants: [Console]
}
