enum Msg { Start }

fn update(msg: Msg) -> List<Effect<Msg>> {
  [
    Print("a\tb"),
    Print("say \"hi\" \\ done"),
    Print("\{braces\}"),
    Print("one\ntwo"),
    Print("a\rb"),
    Print("not // a comment"),
    Print("\\n stays"),
    Exit
  ]
}

app core {
  start: Start
  update: update
  grants: [Console]
}
