enum Msg { Start }

fn update(msg: Msg) -> List<Effect<Msg>> {
  let highest = 9223372036854775807
  let lowest = -9223372036854775808
  let minus_one = -1
  [
    Print("{lowest % minus_one}"),
    Print("{highest + lowest}"),
    Print("{lowest + 1} {highest - 1}"),
    Print("{-highest}"),
    Exit
  ]
}

app core {
  start: Start
  update: update
  grants: [Console]
}
