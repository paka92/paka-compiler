enum Msg { Start }

fn update(msg: Msg) -> List<Effect<Msg>> {
  let a = 2
  let b = 3
  let c = 4
  [
    Print("{a + b * c} {(a + b) * c}"),
    Print("{a * b % c} {a + b % c * a}"),
    Print("{-a * b} {a - b - c} {a * b / c} {100 / a / b}"),
    Print("{c - -a} {-a - -b} {-(a + b)}"),
    Exit
  ]
}

app core {
  start: Start
  update: update
  grants: [Console]
}
