enum Msg { Start }

fn si(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ",") + "]"
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let xs = [1, 2, 3]
  let ys = xs[-1..<2]
  [Print(si(ys)), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
