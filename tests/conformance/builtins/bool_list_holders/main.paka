enum Msg { Start }

type Board { name: String, cells: List<Bool>, on: Bool }

enum Shape { Empty, Mask(bits: List<Bool>, n: Int) }

fn sb(xs: List<Bool>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ",") + "]"
}

fn mask(s: Shape) -> String {
  match s {
    Empty => "empty"
    Mask(bits, n) => sb(bits) + " {n}"
  }
}

fn flip(b: inout Bool) { b = !b }

fn set_all(xs: inout List<Bool>, v: Bool) {
  for i in 0..<len(xs) { xs[i] = v }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var board = Board { name: "b", cells: [false, true, false], on: true }
  append(&board.cells, true)
  board.cells[0] = board.on
  let copy = board
  board.cells[1] = false
  var shape = Mask([true, false, true], 3)
  let before = mask(shape)
  match shape {
    Mask(bits, n) => {
      var more = [false]
      extend(&more, bits)
      shape = Mask(more, n + 1)
    }
    Empty => shape = Empty
  }
  var grid: List<List<Bool>> = [[true, false], [], [false, false, true]]
  append(&grid[1], true)
  grid[2][0] = true
  append(&grid, list_of(true, count: 2))
  var rows: List<String> = []
  for row in grid { append(&rows, sb(row)) }
  var row = [false, false, false, false, false, false, false, false, false, false]
  flip(&row[4])
  flip(&row[5])
  flip(&row[4])
  flip(&grid[0][1])
  set_all(&grid[3], false)
  var m: Map<String, List<Bool>> = ["a": [true], "b": [false, true]]
  append(&m["a"], false)
  m["c"] = [true, true, false]
  var flags: Map<Int, Bool> = [3: true, 1: false, 2: true]
  flags[7] = false
  var vs = values(flags)
  append(&vs, true)
  for i in 0..<20 { append(&vs, i % 2 == 0) }
  vs[0] = true
  let vcopy = vs
  vs[3] = true
  let empty: Map<Int, Bool> = [:]
  var none = values(empty)
  append(&none, true)
  [Print(sb(board.cells) + " " + sb(copy.cells)), Print(before + " / " + mask(shape)), Print(join(rows, " ")), Print(sb(row) + " " + sb(grid[0]) + " " + sb(grid[3])), Print(sb(m["a"]) + " " + sb(m["b"]) + " " + sb(m["c"])), Print(sb(vs)), Print(sb(vcopy)), Print(sb(none)), Print("{copy == board} {grid == grid} {m == m} {values(flags) == [false, true, true, false]}"), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
