enum Msg { Start }

fn ss(xs: List<String>) -> String {
  "{len(xs)}:[" + join(xs, "|") + "]"
}

fn si(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ",") + "]"
}

fn n(x: Int) -> String { "{x}" }

fn update(msg: Msg) -> List<Effect<Msg>> {
  let e: Map<String, Int> = [:]
  let f: Map<Int, String> = [:]
  [Print(ss(keys(e))), Print(si(values(e))), Print(ss(values(f))), Print(si(keys(f))), Print(n(len(e))), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
