enum Msg { Start }

fn ms(m: Map<String, Int>) -> String {
  var parts: List<String> = []
  for k in keys(m) { append(&parts, "{k}={unwrap_or(get(m, k), -1)}") }
  "[" + join(parts, ",") + "]"
}

fn mi(m: Map<Int, Int>) -> String {
  var parts: List<String> = []
  for k in keys(m) { append(&parts, "{k}={unwrap_or(get(m, k), -1)}") }
  "[" + join(parts, ",") + "]"
}

fn si(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ",") + "]"
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var a: Map<Int, Int> = [:]
  for i in 0..<40 {
    a[(i * 37) % 41 - 20] = i
  }
  a[9000000000000] = 1
  a[-9000000000000] = 2
  for i in 0..<30 {
    remove(&a, (i * 11) % 41 - 20)
  }
  var b: Map<Int, Int> = [:]
  for k in keys(a) {
    b[k] = 0
  }
  for k in keys(a) {
    b[k] = unwrap_or(get(a, k), 0)
  }
  var s: Map<String, Int> = [:]
  for w in ["pear", "apple", "fig", "", "banana split", "b", "apples", "é", "z", "fig"] {
    s[w] = len(w)
  }
  remove(&s, "apple")
  remove(&s, "pear")
  s["kiwi"] = 4
  let t: Map<String, Int> = ["kiwi": 4, "z": 1, "é": 1, "banana split": 12, "apples": 6, "b": 1, "fig": 3, "": 0]
  [
    Print(si(keys(a))),
    Print(si(values(a))),
    Print("{a == b} {s == t} {len(s)}"),
    Print(ms(s)),
    Print(mi(b)),
    Exit
  ]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
