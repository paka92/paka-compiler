enum Msg { Start }

fn si(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ",") + "]"
}

fn ss(xs: List<String>) -> String {
  "{len(xs)}:[" + join(xs, "|") + "]"
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var xs = [1, 2, 3, 4]
  swap(&xs, 0, 3)
  swap(&xs, 1, 1)
  swap(&xs, 2, 1)
  var ws = ["a", "é"]
  swap(&ws, 0, 1)
  [Print(si(xs)), Print(ss(ws)), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
