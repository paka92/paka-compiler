enum Msg { Start }

fn si(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ",") + "]"
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let xs = [10, 20, 30, 40, 50]
  [Print(si(xs[1..<3])), Print(si(xs[0..<5])), Print(si(xs[2..<2])), Print(si(xs[5..<5])), Print(si(xs[0..<0])), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
