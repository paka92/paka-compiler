enum Msg { Start }

fn sb(xs: List<Bool>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ",") + "]"
}

fn trues_first(a: Bool, b: Bool) -> Bool { a && !b }

fn update(msg: Msg) -> List<Effect<Msg>> {
  var xs = list_of(false, count: 10)
  xs[3] = true
  xs[9] = true
  xs[0] = !xs[3]
  let read = "{xs[0]} {xs[1]} {xs[3]} {xs[9]}"
  append(&xs, true)
  append(&xs, false)
  let last = pop(&xs)
  insert(&xs, true, at: 1)
  insert(&xs, false, at: 0)
  let gone = remove_at(&xs, 2)
  extend(&xs, [false, true, true])
  let grown = sb(xs)
  swap(&xs, 0, 1)
  reverse(&xs)
  let turned = sb(xs)
  sort_by(&xs, trues_first)
  var count = 0
  for x in xs {
    if x { count += 1 }
  }
  var many: List<Bool> = []
  for i in 0..<100 { append(&many, i % 3 == 0) }
  var odd = 0
  for i in 0..<len(many) {
    if many[i] { odd += 1 }
  }
  let part = many[2..<8]
  let same = [true, false] == [true, false]
  let differ = [true, false] == [true, true]
  let shorter = [true] == [true, true]
  [Print(read), Print("{last} {gone}"), Print(grown), Print(turned), Print(sb(xs)), Print("{count} {odd} {len(many)}"), Print(sb(part)), Print("{same} {differ} {shorter} {contains(xs, false)} {unwrap_or(find(xs, false), -1)}"), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
