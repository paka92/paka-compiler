enum Msg { Start }

fn ms(m: Map<String, Int>) -> String {
  var parts: List<String> = []
  for k in keys(m) { append(&parts, "{k}={unwrap_or(get(m, k), -1)}") }
  "[" + join(parts, ",") + "]"
}

fn mi(m: Map<Int, Int>) -> String {
  var parts: List<String> = []
  for k in keys(m) { append(&parts, "{k}={unwrap_or(get(m, k), -1)}") }
  "[" + join(parts, ",") + "]"
}

fn map_bools(m: Map<Int, Bool>) -> List<String> {
  var parts: List<String> = []
  for k in keys(m) { append(&parts, "{k}={unwrap_or(get(m, k), false)}") }
  parts
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var counts: Map<String, Int> = [:]
  var seen: Map<Int, Bool> = [:]
  var total = 0
  for w in ["to", "be", "or", "not", "to", "be", "that", "is", "the", "question", "to", "be"] {
    let c = unwrap_or(get(counts, w), 0) + 1
    counts[w] = c
    let here = has(seen, len(w))
    seen[len(w)] = here
    let d = unwrap_or(get(counts, w), 0)
    counts[w] += d
    let e = unwrap_or(get(counts, w), 0) + len(keys(counts))
    counts[w] = e
    let f = unwrap_or(get(counts, w), 0)
    counts[w] = f + len(values(counts))
    total += c
  }
  var n: Map<Int, Int> = [3: 30]
  var k = 3
  let g = unwrap_or(get(n, k), 0)
  k = 4
  n[k] = g
  let h = unwrap_or(get(n, 5), 0) + unwrap_or(get(n, k), 0)
  n[5] = h
  var o: Map<Int, Int> = [5: 50]
  let j = unwrap_or(get(n, k), 0) + unwrap_or(get(o, 2 + 3), 0)
  n[k] = j
  [Print("{total} {ms(counts)}"), Print(join(map_bools(seen), ",")), Print(mi(n)), Print(mi(o)), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
