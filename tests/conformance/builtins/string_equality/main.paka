// String equality: length first, then every byte; built, literal, empty and multi-byte texts,
// and Strings inside records, lists and maps.

enum Msg { Start }

type Tag { name: String, n: Int }

fn mark(b: Bool) -> String {
  if b { "y" } else { "n" }
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  let e = ""
  let ab = "a" + "b"
  let ac = "a" + "c"
  let eu = "€"
  let es = mark(e == "") + mark(ab == "ab") + mark(ab == ac) + mark(ab == "abc")
  let more = mark("abc" == ab) + mark(eu == "€") + mark(eu == "e") + mark(ab != ac)
  let tags = mark(Tag { name: ab, n: 1 } == Tag { name: "ab", n: 1 })
  let other = mark(Tag { name: ab, n: 1 } == Tag { name: "ac", n: 1 })
  let lists = mark(["a", ab] == ["a", "ab"]) + mark(["a", ab] == ["a", ac])
  var m: Map<String, Int> = [:]
  m[ab] = 1
  var n: Map<String, Int> = [:]
  n["ab"] = 1
  var o: Map<String, Int> = [:]
  o[ac] = 1
  let maps = mark(m == n) + mark(m == o)
  [Print(es + more + " " + tags + other + " " + lists + " " + maps), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
