enum Msg { Start }

fn always(a: Int, b: Int) -> Bool { true }

fn si(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ",") + "]"
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var a = [3, 1, 2]
  sort_by(&a, always)
  var b = [1, 2, 3, 4, 5]
  sort_by(&b, always)
  [Print(si(a)), Print(si(b)), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
