enum Msg { Start }

fn steep(a: Int, b: Int) -> Bool { 10 / (a - b) > 0 }

fn si(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ",") + "]"
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var xs = [4, 4, 1]
  sort_by(&xs, steep)
  [Print(si(xs)), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
