enum Msg { Start }

fn f1(x: Float) -> String { fixed(x, digits: 1) }

fn sf(xs: List<Float>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, f1(x)) }
  "[" + join(parts, ",") + "]"
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var a = [2.5, -1.0, 0.0, 10.0, -0.5]
  sort(&a)
  let inf = 1.0 / 0.0
  var b = [inf, 0.0 - inf, 0.0]
  sort(&b)
  [Print(sf(a)), Print(sf(b)), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
