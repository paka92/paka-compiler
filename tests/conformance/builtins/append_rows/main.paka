enum Msg { Start }

fn si(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ",") + "]"
}

fn ss(xs: List<String>) -> String {
  "{len(xs)}:[" + join(xs, "|") + "]"
}

fn n(x: Int) -> String { "{x}" }

fn update(msg: Msg) -> List<Effect<Msg>> {
  var xs: List<Int> = []
  append(&xs, 3)
  append(&xs, 1)
  append(&xs, 3)
  var ws: List<String> = []
  append(&ws, "é")
  append(&ws, "")
  var nested: List<List<Int>> = [[1]]
  append(&nested, [])
  append(&nested, [2, 3])
  [Print(si(xs)), Print(ss(ws)), Print(n(len(nested)) + " " + si(nested[2])), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
