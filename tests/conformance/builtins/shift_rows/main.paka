enum Msg { Start }

fn n(x: Int) -> String { "{x}" }

fn update(msg: Msg) -> List<Effect<Msg>> {
  let l1 = join([n(shift_left(1, 0)), n(shift_left(1, 3)), n(shift_left(-1, 1)), n(shift_left(9223372036854775807, 1)), n(shift_left(3, 62)), n(shift_left(1, 63)), n(shift_left(0, 63))], " ")
  let l2 = join([n(shift_right(8, 1)), n(shift_right(-8, 1)), n(shift_right(-7, 1)), n(shift_right(1, 1)), n(shift_right(-1, 0))], " ")
  let l3 = join([n(shift_right(9223372036854775807, 62)), n(shift_right(9223372036854775807, 63)), n(shift_right(-1, 63)), n(shift_right(-9223372036854775808, 63))], " ")
  [Print(l1), Print(l2), Print(l3), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
