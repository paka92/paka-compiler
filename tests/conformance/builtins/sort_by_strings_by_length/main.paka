enum Msg { Start }

fn shorter(a: String, b: String) -> Bool { len(a) < len(b) }

fn ss(xs: List<String>) -> String {
  "{len(xs)}:[" + join(xs, "|") + "]"
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var ws = ["ccc", "a", "bb", "d", "éé", "日"]
  sort_by(&ws, shorter)
  [Print(ss(ws)), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
