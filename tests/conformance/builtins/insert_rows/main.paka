enum Msg { Start }

fn si(xs: List<Int>) -> String {
  var parts: List<String> = []
  for x in xs { append(&parts, "{x}") }
  "[" + join(parts, ",") + "]"
}

fn ss(xs: List<String>) -> String {
  "{len(xs)}:[" + join(xs, "|") + "]"
}

fn update(msg: Msg) -> List<Effect<Msg>> {
  var xs = [10, 20, 30]
  insert(&xs, 5, at: 0)
  insert(&xs, 15, at: 2)
  insert(&xs, 99, at: len(xs))
  var e: List<Int> = []
  insert(&e, 1, at: 0)
  var ws = ["b"]
  insert(&ws, "a", at: 0)
  insert(&ws, "é", at: 2)
  [Print(si(xs)), Print(si(e)), Print(ss(ws)), Exit]
}

app builtins {
  start: Start
  update: update
  grants: [Console]
}
