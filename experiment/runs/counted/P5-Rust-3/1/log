{"event":"reply","n":1,"text":"```rust\nuse std::collections::HashMap;\nuse std::rc::Rc;\n\n#[derive(Clone)]\nenum Kind {\n    Num(i64),\n    Bool(bool),\n    Sym(String),\n    List(Vec<Node>),\n}\n#[derive(Clone)]\nstruct Node {\n    line: usize,\n    col: usize,\n    kind: Kind,\n}\nstruct Func {\n    name: String,\n    params: Vec<String>,\n    body: Option<Rc<Node>>,\n}\n#[derive(Clone)]\nenum Value {\n    Num(i64),\n    Bool(bool),\n    Fn(Rc<Func>),\n}\nstruct Err(usize, usize, String);\n\nfn e<T>(n: &Node, s: &str) -> Result<T, Err> {\n    Err(Err(n.line, n.col, s.to_string()))\n}\n\nfn is_name(n: &Node) -> bool {\n    match &n.kind {\n        Kind::Sym(s) => s != \"if\" && s != \"let\" && s != \"define\",\n        _ => false,\n    }\n}\nfn sym_of(n: &Node) -> &str {\n    match &n.kind {\n        Kind::Sym(s) => s,\n        _ => \"\",\n    }\n}\n\nfn eval(\n    n: &Node,\n    locals: &Vec<(String, Value)>,\n    depth: usize,\n    g: &HashMap<String, Value>,\n) -> Result<Value, Err> {\n    match &n.kind {\n        Kind::Num(v) => Ok(Value::Num(*v)),\n        Kind::Bool(b) => Ok(Value::Bool(*b)),\n        Kind::Sym(s) => {\n            for (k, v) in locals.iter().rev() {\n                if k == s {\n                    return Ok(v.clone());\n                }\n            }\n            if let Some(v) = g.get(s) {\n                return Ok(v.clone());\n            }\n            if matches!(s.as_str(), \"+\" | \"-\" | \"*\" | \"/\" | \"<\" | \"=\") {\n                return Ok(Value::Fn(Rc::new(Func {\n                    name: s.clone(),\n                    params: vec![],\n                    body: None,\n                })));\n            }\n            e(n, &format!(\"unbound {}\", s))\n        }\n        Kind::List(items) => {\n            if items.is_empty() {\n                return e(n, \"empty call\");\n            }\n            if let Kind::Sym(s) = &items[0].kind {\n                match s.as_str() {\n                    \"define\" => return e(n, \"bad define\"),\n                    \"if\" => {\n                        if items.len() != 4 {\n                            return e(n, \"bad if\");\n                        }\n                        let c = eval(&items[1], locals, depth, g)?;\n                        return match c {\n                            Value::Bool(true) => eval(&items[2], locals, depth, g),\n                            Value::Bool(false) => eval(&items[3], locals, depth, g),\n                            _ => e(n, \"type error\"),\n                        };\n                    }\n                    \"let\" => {\n                        if items.len() != 3 {\n                            return e(n, \"bad let\");\n                        }\n                        let b = match &items[1].kind {\n                            Kind::List(b) => b,\n                            _ => return e(n, \"bad let\"),\n                        };\n                        if b.len() % 2 != 0 {\n                            return e(n, \"bad let\");\n                        }\n                        let mut names: Vec<&str> = vec![];\n                        for i in (0..b.len()).step_by(2) {\n                            if !is_name(&b[i]) {\n                                return e(n, \"bad let\");\n                            }\n                            let s = sym_of(&b[i]);\n                            if names.contains(&s) {\n                                return e(n, \"bad let\");\n                            }\n                            names.push(s);\n                        }\n                        let mut nl = locals.clone();\n                        for i in (0..b.len()).step_by(2) {\n                            let v = eval(&b[i + 1], locals, depth, g)?;\n                            nl.push((sym_of(&b[i]).to_string(), v));\n                        }\n                        return eval(&items[2], &nl, depth, g);\n                    }\n                    _ => {}\n                }\n            }\n            let mut vals = vec![];\n            for it in items {\n                vals.push(eval(it, locals, depth, g)?);\n            }\n            let f = match &vals[0] {\n                Value::Fn(f) => f.clone(),\n                _ => return e(n, \"not a function\"),\n            };\n            let args = &vals[1..];\n            if let Some(body) = &f.body {\n                if args.len() != f.params.len() {\n                    return e(n, \"wrong arity\");\n                }\n                if depth >= 50 {\n                    return e(n, \"too deep\");\n                }\n                let nl: Vec<(String, Value)> = f\n                    .params\n                    .iter()\n                    .cloned()\n                    .zip(args.iter().cloned())\n                    .collect();\n                return eval(body, &nl, depth + 1, g);\n            }\n            if args.len() != 2 {\n                return e(n, \"wrong arity\");\n            }\n            let op = f.name.as_str();\n            match (&args[0], &args[1]) {\n                (Value::Num(a), Value::Num(b)) => {\n                    let (a, b) = (*a, *b);\n                    let r = match op {\n                        \"<\" => return Ok(Value::Bool(a < b)),\n                        \"=\" => return Ok(Value::Bool(a == b)),\n                        \"+\" => a + b,\n                        \"-\" => a - b,\n                        \"*\" => a * b,\n                        _ => {\n                            if b == 0 {\n                                return e(n, \"division by zero\");\n                            }\n                            a / b\n                        }\n                    };\n                    if r < -9999999 || r > 9999999 {\n                        return e(n, \"overflow\");\n                    }\n                    Ok(Value::Num(r))\n                }\n                (Value::Bool(a), Value::Bool(b)) if op == \"=\" => Ok(Value::Bool(a == b)),\n                _ => e(n, \"type error\"),\n            }\n        }\n    }\n}\n\nfn main() {\n    let path = std::env::args().nth(1).unwrap();\n    let data = std::fs::read(&path).unwrap();\n    let chars: Vec<char> = data.iter().map(|&b| b as char).collect();\n    // parse\n    let mut stack: Vec<(usize, usize, Vec<Node>)> = vec![(0, 0, vec![])];\n    let (mut line, mut col) = (1usize, 1usize);\n    let mut i = 0;\n    let fail = |l: usize, c: usize, w: &str| -> ! {\n        println!(\"error: line {} col {}: {}\", l, c, w);\n        std::process::exit(20);\n    };\n    while i < chars.len() {\n        let c = chars[i];\n        if c == '\\n' {\n            line += 1;\n            col = 1;\n            i += 1;\n        } else if c == ' ' {\n            col += 1;\n            i += 1;\n        } else if c == ';' {\n            while i < chars.len() && chars[i] != '\\n' {\n                i += 1;\n            }\n        } else if c == '(' {\n            stack.push((line, col, vec![]));\n            col += 1;\n            i += 1;\n        } else if c == ')' {\n            if stack.len() == 1 {\n                fail(line, col, \"unexpected )\");\n            }\n            let (l, cc, items) = stack.pop().unwrap();\n            stack.last_mut().unwrap().2.push(Node {\n                line: l,\n                col: cc,\n                kind: Kind::List(items),\n            });\n            col += 1;\n            i += 1;\n        } else {\n            let st = i;\n            while i < chars.len() && !matches!(chars[i], ' ' | '\\n' | '(' | ')' | ';') {\n                i += 1;\n            }\n            let s: String = chars[st..i].iter().collect();\n            let b = s.as_bytes();\n            let digits = if b[0] == b'-' { &b[1..] } else { &b[..] };\n            let kind = if !digits.is_empty()\n                && digits.len() <= 7\n                && digits.iter().all(|x| x.is_ascii_digit())\n            {\n                Kind::Num(s.parse::<i64>().unwrap())\n            } else if s == \"#t\" {\n                Kind::Bool(true)\n            } else if s == \"#f\" {\n                Kind::Bool(false)\n            } else if b[0] == b'#'\n                || b[0].is_ascii_digit()\n                || (b[0] == b'-' && b.len() > 1 && b[1].is_ascii_digit())\n            {\n                fail(line, col, \"bad atom\");\n            } else {\n                Kind::Sym(s)\n            };\n            stack.last_mut().unwrap().2.push(Node { line, col, kind });\n            col += i - st;\n        }\n    }\n    if stack.len() > 1 {\n        fail(stack[1].0, stack[1].1, \"unclosed (\");\n    }\n    let top = stack.pop().unwrap().2;\n    let mut g: HashMap<String, Value> = HashMap::new();\n    let mut out = String::new();\n    let mut run = |n: &Node, out: &mut String, g: &mut HashMap<String, Value>| -> Result<(), Err> {\n        if let Kind::List(items) = &n.kind {\n            if !items.is_empty() && sym_of(&items[0]) == \"define\" && matches!(items[0].kind, Kind::Sym(_)) {\n                if items.len() != 3 {\n                    return e(n, \"bad define\");\n                }\n                match &items[1].kind {\n                    Kind::Sym(_) => {\n                        if !is_name(&items[1]) {\n                            return e(n, \"bad define\");\n                        }\n                        let v = eval(&items[2], &vec![], 0, g)?;\n                        g.insert(sym_of(&items[1]).to_string(), v);\n                    }\n                    Kind::List(h) => {\n                        if h.is_empty() || !h.iter().all(is_name) {\n                            return e(n, \"bad define\");\n                        }\n                        let mut ps: Vec<String> = vec![];\n                        for p in &h[1..] {\n                            let s = sym_of(p).to_string();\n                            if ps.contains(&s) {\n                                return e(n, \"bad define\");\n                            }\n                            ps.push(s);\n                        }\n                        let name = sym_of(&h[0]).to_string();\n                        g.insert(\n                            name.clone(),\n                            Value::Fn(Rc::new(Func {\n                                name,\n                                params: ps,\n                                body: Some(Rc::new(items[2].clone())),\n                            })),\n                        );\n                    }\n                    _ => return e(n, \"bad define\"),\n                }\n                return Ok(());\n            }\n        }\n        let v = eval(n, &vec![], 0, g)?;\n        match v {\n            Value::Num(x) => out.push_str(&format!(\"{}\\n\", x)),\n            Value::Bool(b) => out.push_str(if b { \"#t\\n\" } else { \"#f\\n\" }),\n            Value::Fn(f) => out.push_str(&format!(\"<fn {}>\\n\", f.name)),\n        }\n        Ok(())\n    };\n    for n in &top {\n        if let Err(Err(l, c, w)) = run(n, &mut out, &mut g) {\n            print!(\"{}\", out);\n            println!(\"error: line {} col {}: {}\", l, c, w);\n            std::process::exit(20);\n        }\n    }\n    print!(\"{}\", out);\n}\n```","input":3222,"output":5133,"cut_off":false,"ms":28250,"at":1792053801980}
