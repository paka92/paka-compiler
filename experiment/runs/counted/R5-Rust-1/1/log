{"event":"reply","n":1,"text":"```rust\nuse std::collections::HashMap;\nuse std::fs;\n\nfn valid_name(s: &str) -> bool {\n    let n = s.len();\n    n >= 1 && n <= 20 && s.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')\n}\n\nfn main() {\n    let path = std::env::args().nth(1).unwrap();\n    let data = fs::read(&path).unwrap();\n    let text: String = data.iter().map(|&b| b as char).collect();\n    let mut ids: HashMap<String, usize> = HashMap::new();\n    let mut names: Vec<String> = Vec::new();\n    let mut edges: Vec<(usize, usize, u64)> = Vec::new();\n    let mut trips: Vec<(String, String)> = Vec::new();\n    let mut get = |s: &str, ids: &mut HashMap<String, usize>, names: &mut Vec<String>| -> usize {\n        if let Some(&i) = ids.get(s) {\n            return i;\n        }\n        let i = names.len();\n        ids.insert(s.to_string(), i);\n        names.push(s.to_string());\n        i\n    };\n    for (idx, line) in text.split('\\n').enumerate() {\n        let n = idx + 1;\n        let w: Vec<&str> = line.split(' ').filter(|x| !x.is_empty()).collect();\n        if w.is_empty() {\n            continue;\n        }\n        let bad = || {\n            println!(\"error: line {}: bad line\", n);\n            std::process::exit(20);\n        };\n        match w[0] {\n            \"one\" | \"two\" => {\n                if w.len() != 4\n                    || !valid_name(w[1])\n                    || !valid_name(w[2])\n                    || w[3].len() < 1\n                    || w[3].len() > 6\n                    || !w[3].bytes().all(|b| b.is_ascii_digit())\n                {\n                    bad();\n                }\n                if w[1] == w[2] {\n                    println!(\"error: line {}: loop road\", n);\n                    std::process::exit(20);\n                }\n                let c: u64 = w[3].parse().unwrap();\n                let a = get(w[1], &mut ids, &mut names);\n                let b = get(w[2], &mut ids, &mut names);\n                edges.push((a, b, c));\n                if w[0] == \"two\" {\n                    edges.push((b, a, c));\n                }\n            }\n            \"trip\" => {\n                if w.len() != 3 || !valid_name(w[1]) || !valid_name(w[2]) {\n                    bad();\n                }\n                trips.push((w[1].to_string(), w[2].to_string()));\n            }\n            _ => bad(),\n        }\n    }\n    if trips.is_empty() {\n        println!(\"error: no trips\");\n        std::process::exit(20);\n    }\n    let v = names.len();\n    let mut adj: Vec<Vec<(usize, u64)>> = vec![vec![]; v];\n    let mut radj: Vec<Vec<(usize, u64)>> = vec![vec![]; v];\n    for &(a, b, c) in &edges {\n        adj[a].push((b, c));\n        radj[b].push((a, c));\n    }\n    let mut out = String::new();\n    for (f, t) in &trips {\n        let head = format!(\"{} to {}: \", f, t);\n        let fi = match ids.get(f) {\n            Some(&i) => i,\n            None => {\n                out.push_str(&format!(\"{}unknown {}\\n\", head, f));\n                continue;\n            }\n        };\n        let ti = match ids.get(t) {\n            Some(&i) => i,\n            None => {\n                out.push_str(&format!(\"{}unknown {}\\n\", head, t));\n                continue;\n            }\n        };\n        let mut d: Vec<Option<(u64, u64)>> = vec![None; v];\n        let mut done = vec![false; v];\n        d[ti] = Some((0, 0));\n        loop {\n            let mut best: Option<usize> = None;\n            for i in 0..v {\n                if !done[i] && d[i].is_some() {\n                    if best.map_or(true, |b| d[i].unwrap() < d[b].unwrap()) {\n                        best = Some(i);\n                    }\n                }\n            }\n            let u = match best {\n                Some(u) => u,\n                None => break,\n            };\n            done[u] = true;\n            let du = d[u].unwrap();\n            for &(p, c) in &radj[u] {\n                let nd = (du.0 + c, du.1 + 1);\n                if d[p].map_or(true, |x| nd < x) {\n                    d[p] = Some(nd);\n                }\n            }\n        }\n        let dist = match d[fi] {\n            None => {\n                out.push_str(&format!(\"{}no route\\n\", head));\n                continue;\n            }\n            Some(x) => x,\n        };\n        let mut cur = fi;\n        let mut path = vec![names[cur].clone()];\n        while cur != ti {\n            let dc = d[cur].unwrap();\n            let mut best: Option<usize> = None;\n            for &(w, c) in &adj[cur] {\n                if let Some(dw) = d[w] {\n                    if (dw.0 + c, dw.1 + 1) == dc {\n                        if best.map_or(true, |b| names[w] < names[b]) {\n                            best = Some(w);\n                        }\n                    }\n                }\n            }\n            cur = best.unwrap();\n            path.push(names[cur].clone());\n        }\n        out.push_str(&format!(\n            \"{}cost {}, {} {}: {}\\n\",\n            head,\n            dist.0,\n            dist.1,\n            if dist.1 == 1 { \"road\" } else { \"roads\" },\n            path.join(\" \")\n        ));\n    }\n    print!(\"{}\", out);\n}\n```","input":2480,"output":2641,"cut_off":false,"ms":16830,"at":1792055747357}
