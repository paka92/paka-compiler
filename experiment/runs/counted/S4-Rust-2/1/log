{"event":"reply","n":1,"text":"```rust\nuse std::collections::BTreeMap;\nuse std::fs;\n\nfn money(c: u32) -> String {\n    format!(\"{}.{:02}\", c / 100, c % 100)\n}\n\nfn digits(s: &str, min: usize, max: usize) -> bool {\n    s.len() >= min && s.len() <= max && s.bytes().all(|b| b.is_ascii_digit())\n}\n\nfn slot_ok(s: &str) -> bool {\n    let b = s.as_bytes();\n    b.len() == 2 && b[0].is_ascii_uppercase() && (b[1] >= b'1' && b[1] <= b'9')\n}\n\nfn num(s: &str) -> u32 {\n    s.parse().unwrap()\n}\n\nenum Cmd {\n    Load(String, u32, u32),\n    Coin(u32),\n    Select(String),\n    Cancel,\n}\n\nfn parse_cmd(line: &str) -> Option<Cmd> {\n    let t: Vec<&str> = line.split(' ').collect();\n    if t.iter().any(|x| x.is_empty()) {\n        return None;\n    }\n    match t[0] {\n        \"load\" if t.len() == 4 => {\n            if !slot_ok(t[1]) {\n                return None;\n            }\n            let p = t[2];\n            let pb = p.as_bytes();\n            let n = pb.len();\n            if n < 4 || n > 5 || pb[n - 3] != b'.' {\n                return None;\n            }\n            let whole = &p[..n - 3];\n            let frac = &p[n - 2..];\n            if !digits(whole, 1, 2) || !digits(frac, 2, 2) {\n                return None;\n            }\n            let price = num(whole) * 100 + num(frac);\n            if price < 5 || price % 5 != 0 {\n                return None;\n            }\n            if !digits(t[3], 1, 2) {\n                return None;\n            }\n            let c = num(t[3]);\n            if c < 1 {\n                return None;\n            }\n            Some(Cmd::Load(t[1].to_string(), price, c))\n        }\n        \"coin\" if t.len() == 2 => {\n            if !digits(t[1], 1, 3) {\n                return None;\n            }\n            Some(Cmd::Coin(num(t[1])))\n        }\n        \"select\" if t.len() == 2 => {\n            if !slot_ok(t[1]) {\n                return None;\n            }\n            Some(Cmd::Select(t[1].to_string()))\n        }\n        \"cancel\" if t.len() == 1 => Some(Cmd::Cancel),\n        _ => None,\n    }\n}\n\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    let data = fs::read(&args[1]).unwrap_or_default();\n    let text: String = data.iter().map(|&b| b as char).collect();\n    let mut lines: Vec<&str> = text.split('\\n').collect();\n    if text.is_empty() || text.ends_with('\\n') {\n        lines.pop();\n    }\n    let coins = [5u32, 10, 20, 50, 100, 200];\n    let mut boxc = [0u32; 6];\n    let mut ok = false;\n    if !lines.is_empty() {\n        let t: Vec<&str> = lines[0].split(' ').collect();\n        if t.len() == 7 && t[0] == \"box\" && t[1..].iter().all(|x| digits(x, 1, 3)) {\n            ok = true;\n            for i in 0..6 {\n                boxc[i] = num(t[i + 1]);\n            }\n        }\n    }\n    if !ok {\n        println!(\"error: bad box\");\n        std::process::exit(20);\n    }\n    let mut cmds = Vec::new();\n    for (i, l) in lines.iter().enumerate().skip(1) {\n        match parse_cmd(l) {\n            Some(c) => cmds.push(c),\n            None => {\n                println!(\"error: line {}: bad command\", i + 1);\n                std::process::exit(20);\n            }\n        }\n    }\n    let mut out = String::new();\n    let mut credit = 0u32;\n    let mut session: Vec<u32> = Vec::new();\n    let mut slots: BTreeMap<String, (u32, u32)> = BTreeMap::new(); // price, items\n    for c in cmds {\n        match c {\n            Cmd::Load(s, p, n) => {\n                if credit != 0 {\n                    out.push_str(\"busy\\n\");\n                    continue;\n                }\n                let cur = slots.get(&s).map(|x| x.1).unwrap_or(0);\n                if cur + n > 20 {\n                    out.push_str(&format!(\"slot full {}\\n\", s));\n                    continue;\n                }\n                slots.insert(s, (p, cur + n));\n            }\n            Cmd::Coin(v) => {\n                l