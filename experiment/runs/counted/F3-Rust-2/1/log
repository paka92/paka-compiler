 e;\n        }\n    }\n    let mut out: Vec<(Vec<u8>, bool)> = Vec::new();\n    let mut cur = 1usize;\n    let mut ins = 0;\n    let mut del = 0;\n    let mut i = 0;\n    while i < cls.len() {\n        if let L::Cmd(k, a, b) = cls[i].clone() {\n            let mut texts = Vec::new();\n            let mut j = i + 1;\n            while j < cls.len() && matches!(cls[j], L::Text) {\n                let l = &sl[j];\n                texts.push(if l.len() <= 1 { Vec::new() } else { l[2..].to_vec() });\n                j += 1;\n            }\n            ins += texts.len();\n            let upto = if k == b'a' { a } else { a - 1 };\n            while cur <= upto {\n                out.push((tl[cur - 1].clone(), cur == n && nolf));\n                cur += 1;\n            }\n            if k != b'a' {\n                del += b - a + 1;\n                cur = b + 1;\n            }\n            if k != b'd' {\n                for t in texts {\n                    out.push((t, false));\n                }\n            }\n            i = j;\n        } else {\n            i += 1;\n        }\n    }\n    while cur <= n {\n        out.push((tl[cur - 1].clone(), cur == n && nolf));\n        cur += 1;\n    }\n    let mut buf = Vec::new();\n    let cnt = out.len();\n    for (idx, (t, nl)) in out.iter().enumerate() {\n        buf.extend_from_slice(t);\n        if !(*nl && idx + 1 == cnt) {\n            buf.push(b'\\n');\n        }\n    }\n    let ok = match fs::File::create(on) {\n        Ok(mut f) => f.write_all(&buf).is_ok(),\n        Err(_) => false,\n    };\n    if !ok {\n        fail(format!(\"error: cannot write {}\", on));\n    }\n    let k = out.len();\n    println!(\n        \"wrote {} {} to {} (+{} -{})\",\n        k,\n        if k == 1 { \"line\" } else { \"lines\" },\n        on,\n        ins,\n        del\n    );\n}\n```","input":6142,"output":3613,"cut_off":false,"ms":23243,"at":1792056867379}
