{"event":"reply","n":1,"text":"```rust\nuse std::fs;\nuse std::io::Write;\n\nfn split(d: &[u8]) -> Vec<Vec<u8>> {\n    let mut v: Vec<Vec<u8>> = d.split(|&c| c == b'\\n').map(|x| x.to_vec()).collect();\n    if let Some(l) = v.last() {\n        if l.is_empty() {\n            v.pop();\n        }\n    }\n    v\n}\n\nfn num(s: &[u8]) -> Option<usize> {\n    if s.is_empty() || s.len() > 4 || !s.iter().all(|c| c.is_ascii_digit()) {\n        return None;\n    }\n    if s[0] == b'0' && s.len() > 1 {\n        return None;\n    }\n    let mut n = 0usize;\n    for &c in s {\n        n = n * 10 + (c - b'0') as usize;\n    }\n    Some(n)\n}\n\n#[derive(Clone)]\nenum L {\n    Cmd(u8, usize, usize),\n    Text,\n    Bad,\n}\n\nfn classify(l: &[u8]) -> L {\n    if l == b\">\" || l.starts_with(b\"> \") {\n        return L::Text;\n    }\n    if l.len() < 3 || l[1] != b' ' {\n        return L::Bad;\n    }\n    let k = l[0];\n    let rest = &l[2..];\n    match k {\n        b'a' => match num(rest) {\n            Some(a) => L::Cmd(b'a', a, a),\n            None => L::Bad,\n        },\n        b'd' | b'c' => {\n            let (a, b) = if let Some(p) = rest.iter().position(|&c| c == b'-') {\n                (num(&rest[..p]), num(&rest[p + 1..]))\n            } else {\n                let a = num(rest);\n                (a, a)\n            };\n            match (a, b) {\n                (Some(a), Some(b)) if a >= 1 => L::Cmd(k, a, b),\n                _ => L::Bad,\n            }\n        }\n        _ => L::Bad,\n    }\n}\n\nfn fail(m: String) -> ! {\n    println!(\"{}\", m);\n    std::process::exit(20);\n}\n\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    let (tn, sn, on) = (&args[1], &args[2], &args[3]);\n    let sd = match fs::read(sn) {\n        Ok(d) => d,\n        Err(_) => fail(format!(\"error: cannot read {}\", sn)),\n    };\n    let sl = split(&sd);\n    let cls: Vec<L> = sl.iter().map(|l| classify(l)).collect();\n    let mut allow = false;\n    for i in 0