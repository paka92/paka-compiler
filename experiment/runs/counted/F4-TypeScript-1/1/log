{"event":"reply","n":1,"text":"```typescript\nimport * as fs from \"fs\";\n\nfunction fail(msg: string): never {\n  process.stdout.write(msg + \"\\n\");\n  process.exit(20);\n}\n\nfunction splitLines(s: string): string[] {\n  if (s.length === 0) return [];\n  const parts = s.split(\"\\n\");\n  if (parts[parts.length - 1] === \"\") parts.pop();\n  return parts;\n}\n\nconst keyRe = /^[A-Za-z0-9_-]{1,20}$/;\nconst mapName = process.argv[2];\nconst listName = process.argv[3];\n\nlet mapText: string;\ntry {\n  mapText = fs.readFileSync(mapName, \"latin1\");\n} catch {\n  fail(\"error: cannot read \" + mapName);\n}\nconst entries = new Map<string, string>();\nconst mlines = splitLines(mapText);\nfor (let n = 0; n < mlines.length; n++) {\n  const words = mlines[n].split(\" \").filter((w) => w.length > 0);\n  if (words.length === 0) continue;\n  if (words.length !== 2 || !keyRe.test(words[0]) || !keyRe.test(words[1])) {\n    fail(\"error: map line \" + (n + 1) + \": bad entry\");\n  }\n  const k = words[0].toLowerCase();\n  if (entries.has(k)) fail(\"error: map line \" + (n + 1) + \": duplicate \" + words[0]);\n  entries.set(k, words[1]);\n}\nif (entries.size === 0) fail(\"error: empty map\");\n\nconst names = splitLines(fs.readFileSync(listName, \"latin1\"));\nconst contents: string[] = [];\nfor (const nm of names) {\n  try {\n    contents.push(fs.readFileSync(nm, \"latin1\"));\n  } catch {\n    fail(\"error: cannot read \" + nm);\n  }\n}\n\nconst results: { out: string; count: number }[] = [];\nfor (let p = 0; p < names.length; p++) {\n  const lines = contents[p].split(\"\\n\");\n  let count = 0;\n  const outLines: string[] = [];\n  for (let ln = 0; ln < lines.length; ln++) {\n    const line = lines[ln];\n    let res = \"\";\n    let pos = 0;\n    let i = 0;\n    while (true) {\n      const s = line.indexOf(\"[[\", i);\n      if (s < 0) break;\n      const e = line.indexOf(\"]]\", s + 2);\n      if (e < 0) fail(\"error: \" + names[p] + \" line \" + (ln + 1) + \" col \" + (s + 1) + \": unclosed link\");\n      const inside = line.substring(s + 2, e);\n      const bar = inside.indexOf(\"|\");\n      const target = bar < 0 ? inside : inside.substring(0, bar);\n      const label = bar < 0 ? \"\" : inside.substring(bar + 1);\n      if (!keyRe.test(target) || label.indexOf(\"|\") >= 0) {\n        fail(\"error: \" + names[p] + \" line \" + (ln + 1) + \" col \" + (s + 1) + \": bad link\");\n      }\n      const nw = entries.get(target.toLowerCase());\n      if (nw !== undefined) {\n        res += line.substring(pos, s + 2) + nw;\n        pos = s + 2 + target.length;\n        count++;\n      }\n      i = e + 2;\n    }\n    res += line.substring(pos);\n    outLines.push(res);\n  }\n  results.push({ out: outLines.join(\"\\n\"), count });\n}\n\nlet total = 0;\nlet pages = 0;\nfor (let p = 0; p < names.length; p++) {\n  if (results[p].count > 0) {\n    try {\n      fs.writeFileSync(names[p], results[p].out, \"latin1\");\n    } catch {\n      fail(\"error: cannot write \" + names[p]);\n    }\n    total += results[p].count;\n    pages++;\n  }\n}\nlet out = \"\";\nfor (let p = 0; p < names.length; p++) {\n  const c = results[p].count;\n  out += names[p] + \": \" + c + (c === 1 ? \" link\" : \" links\") + \"\\n\";\n}\nout += \"rewrote \" + total + (total === 1 ? \" link\" : \" links\") + \" in \" + pages + (pages === 1 ? \" page\" : \" pages\") + \"\\n\";\nprocess.stdout.write(out);\nprocess.exit(0);\n```","input":3134,"output":1959,"cut_off":false,"ms":12618,"at":1792057300597}
