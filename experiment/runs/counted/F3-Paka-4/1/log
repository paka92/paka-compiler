{"event":"reply","n":1,"text":"```paka\ntype Cmd { kind: Int, a: Int, b: Int, line: Int, texts: List<String> }\n\ntype Sess {\n  target: String = \"\"\n  script: String = \"\"\n  out: String = \"\"\n  cmds: List<Cmd> = []\n  summary: String = \"\"\n}\n\nenum Item { Bad, Del(a: Int, b: Int), Chg(a: Int, b: Int), Add(a: Int), Txt(s: String) }\n\nenum Msg {\n  Start(target: String, script: String, out: String),\n  GotScript(text: String),\n  ScriptFail(why: String),\n  GotTarget(text: String),\n  TargetFail(why: String),\n  Written,\n  WriteFail(why: String)\n}\n\nfn parse_num(s: String) -> Option<Int> {\n  let n = len(s)\n  if n == 0 || n > 4 {\n    return None\n  }\n  for c in chars(s) {\n    if !(c >= \"0\" && c <= \"9\") {\n      return None\n    }\n  }\n  if n > 1 && s[0] == \"0\" {\n    return None\n  }\n  parse_int(s)\n}\n\nfn parse_range(rest: String) -> Option<List<Int>> {\n  let parts = split(rest, \"-\")\n  if len(parts) == 1 {\n    let x = parse_num(parts[0])?\n    return Some([x, x])\n  }\n  if len(parts) == 2 {\n    let x = parse_num(parts[0])?\n    let y = parse_num(parts[1])?\n    return Some([x, y])\n  }\n  None\n}\n\nfn parse_line(line: String) -> Item {\n  if line == \">\" {\n    return Txt(\"\")\n  }\n  if starts_with(line, \"> \") {\n    return Txt(line[2..<len(line)])\n  }\n  if len(line) < 3 {\n    return Bad\n  }\n  if line[1] != \" \" {\n    return Bad\n  }\n  let k = line[0]\n  let rest = line[2..<len(line)]\n  if k == \"a\" {\n    match parse_num(rest) {\n      Some(x) => Add(x)\n      None => Bad\n    }\n  } else if k == \"d\" || k == \"c\" {\n    match parse_range(rest) {\n      Some(r) => {\n        if r[0] < 1 {\n          Bad\n        } else if k == \"d\" {\n          Del(r[0], r[1])\n        } else {\n          Chg(r[0], r[1])\n        }\n      }\n      None => Bad\n    }\n  } else {\n    Bad\n  }\n}\n\nfn next_is_text(lines_: List<String>, i: Int) -> Bool {\n  if i + 1 >= len(lines_) {\n    return false\n  }\n  match parse_line(lines_[i + 1]) {\n    Txt(_) => true\n    Bad => false\n    Del(_, _) => false\n    Chg(_, _) => false\n    Add(_) => false\n  }\n}\n\nfn validate(ls: List<String>) -> Result<List<Cmd>, String> {\n  var cmds: List<Cmd> = []\n  var inText = false\n  let total = len(ls)\n  for i in 0..<total {\n    let ln = i + 1\n    let it = parse_line(ls[i])\n    match it {\n      Bad => {\n        return Err(\"error: script line {ln}: bad line\")\n      }\n      Del(a, b) => {\n        if b < a {\n          return Err(\"error: script line {ln}: backward range\")\n        }\n        append(&cmds, Cmd { kind: 0, a: a, b: b, line: ln, texts: [] })\n        inText = false\n      }\n      Chg(a, b) => {\n        if b < a {\n          return Err(\"error: script line {ln}: backward range\")\n        }\n        if !next_is_text(ls, i) {\n          return Err(\"error: script line {ln}: missing text\")\n        }\n        append(&cmds, Cmd { kind: 1, a: a, b: b, line: ln, texts: [] })\n        inText = true\n      }\n      Add(a) => {\n        if !next_is_text(ls, i) {\n          return Err(\"error: script line {ln}: missing text\")\n        }\n        append(&cmds, Cmd { kind: 2, a: a, b: a, line: ln, texts: [] })\n        inText = true\n      }\n      Txt(s) => {\n        if !inText {\n          return Err(\"error: script line {ln}: unexpected text\")\n        }\n        let last = len(cmds) - 1\n        append(&cmds[last].texts, s)\n      }\n    }\n  }\n  Ok(cmds)\n}\n\nfn check(cmds: List<Cmd>, n: Int) -> String {\n  var prev = -1\n  for c in cmds {\n    var lo = 0\n    var hi = 0\n    if c.kind == 2 {\n      if c.a > n {\n        return \"error: script line {c.line}: past end\"\n      }\n      lo = 2 * c.a\n      hi = lo\n    } else {\n      if c.b > n {\n        return \"error: script line {c.line}: past end\"\n      }\n      lo = 2 * c.a - 1\n      hi = 2 * c.b - 1\n    }\n    if lo <= prev {\n      return \"error: script line {c.line}: out of order\"\n    }\n    prev = hi\n  }\n  \"\"\n}\n\nfn build(cmds: List<Cmd>, tl: List<String>, res: inout List<String>) -> Bool {\n  let n = len(tl)\n  var cur = 1\n  for c in cmds {\n    if c.kind == 2 {\n      while cur <= c.a {\n        append(&res, tl[cur - 1])\n        cur += 1\n      }\n      extend(&res, c.texts)\n    } else {\n      while cur < c.a {\n        append(&res, tl[cur - 1])\n        cur += 1\n      }\n      if c.kind == 1 {\n        extend(&res, c.texts)\n      }\n      cur = c.b + 1\n    }\n  }\n  var last = false\n  while cur <= n {\n    append(&res, tl[cur - 1])\n    cur += 1\n    last = true\n  }\n  last\n}\n\nfn finish(s: inout Sess, text: String) -> List<Effect<Msg>> {\n  let tl = lines(text)\n  let err = check(s.cmds, len(tl))\n  if err != \"\" {\n    return [Print(err), ExitWith(20)]\n  }\n  var res: List<String> = []\n  let lastOrig = build(s.cmds, tl, &res)\n  let noNl = lastOrig && len(text) > 0 && !ends_with(text, \"\\n\")\n  var outText = \"\"\n  let k = len(res)\n  for i in 0..<k {\n    outText += res[i]\n    if i < k - 1 || !noNl {\n      outText += \"\\n\"\n    }\n  }\n  var icount = 0\n  var dcount = 0\n  for c in s.cmds {\n    icount += len(c.texts)\n    if c.kind != 2 {\n      dcount += c.b - c.a + 1\n    }\n  }\n  let word = if k == 1 { \"line\" } else { \"lines\" }\n  s.summary = \"wrote {k} {word} to {s.out} (+{icount} -{dcount})\"\n  [WriteFile(s.out, outText, then: Written, or: WriteFail)]\n}\n\nfn update(s: inout Sess, m: Msg) -> List<Effect<Msg>> {\n  match m {\n    Start(tg, sc, o) => {\n      s.target = tg\n      s.script = sc\n      s.out = o\n      [ReadFile(sc, then: GotScript, or: ScriptFail)]\n    }\n    GotScript(text) => {\n      match validate(lines(text)) {\n        Err(e) => [Print(e), ExitWith(20)]\n        Ok(cmds) => {\n          s.cmds = cmds\n          [ReadFile(s.target, then: GotTarget, or: TargetFail)]\n        }\n      }\n    }\n    ScriptFail(_) => [Print(\"error: cannot read {s.script}\"), ExitWith(20)]\n    GotTarget(text) => finish(&s, text)\n    TargetFail(_) => [Print(\"error: cannot read {s.target}\"), ExitWith(20)]\n    Written => [Print(s.summary), Exit]\n    WriteFail(_) => [Print(\"error: cannot write {s.out}\"), ExitWith(20)]\n  }\n}\n\napp patch {\n  state: Sess\n  start: Start\n  update: update\n  grants: [ReadFiles, WriteFiles, Console]\n}\n```","input":12303,"output":9680,"cut_off":false,"ms":64196,"at":1792056788923}
