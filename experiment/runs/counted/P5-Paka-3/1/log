{"event":"submission","n":1,"source":"type Fail { msg: String, line: Int, col: Int }\n\nenum Node {\n  Num(v: Int, line: Int, col: Int),\n  Bol(b: Bool, line: Int, col: Int),\n  Sym(name: String, line: Int, col: Int),\n  Lst(items: List<Node>, line: Int, col: Int)\n}\n\nenum Val { VNum(n: Int), VBool(b: Bool), VFn(name: String, idx: Int) }\n\ntype FnDef { name: String, params: List<String>, body: Node }\n\ntype World { globals: Map<String, Val> = [:], fns: List<FnDef> = [] }\n\ntype Outcome { lines: List<String>, code: Int }\n\nenum Msg { Start(path: String), Loaded(text: String), Failed(why: String) }\n\nfn is_delim(c: String) -> Bool {\n  c == \" \" || c == \"\\n\" || c == \"(\" || c == \")\" || c == \";\"\n}\n\nfn is_digit(c: String) -> Bool {\n  c >= \"0\" && c <= \"9\"\n}\n\nfn all_digits(s: String) -> Bool {\n  for c in chars(s) {\n    if !is_digit(c) {\n      return false\n    }\n  }\n  true\n}\n\nfn is_kw(s: String) -> Bool {\n  s == \"if\" || s == \"let\" || s == \"define\"\n}\n\nfn classify(s: String, line: Int, col: Int) -> Result<Node, Fail> {\n  if s == \"#t\" {\n    return Ok(Bol(true, line, col))\n  }\n  if s == \"#f\" {\n    return Ok(Bol(false, line, col))\n  }\n  let first = s[0]\n  if first == \"#\" {\n    return Err(Fail { msg: \"bad atom\", line: line, col: col })\n  }\n  var numlike = is_digit(first)\n  if first == \"-\" && len(s) > 1 && is_digit(s[1]) {\n    numlike = true\n  }\n  if numlike {\n    var rest = s\n    if first == \"-\" {\n      rest = s[1..<len(s)]\n    }\n    if len(rest) >= 1 && len(rest) <= 7 && all_digits(rest) {\n      return Ok(Num(unwrap_or(parse_int(s), 0), line, col))\n    }\n    return Err(Fail { msg: \"bad atom\", line: line, col: col })\n  }\n  Ok(Sym(s, line, col))\n}\n\nfn parse(text: String) -> Result<List<Node>, Fail> {\n  let cs = chars(text)\n  let n = len(cs)\n  let empty: List<Node> = []\n  var stack: List<List<Node>> = [empty]\n  var ol: List<Int> = [0]\n  var oc: List<Int> = [0]\n  var i = 0\n  var line = 1\n  var col = 1\n  while i < n {\n    let c = cs[i]\n    if c == \"\\n\" {\n      line += 1\n      col = 1\n      i += 1\n    } else if c == \" \" {\n      col += 1\n      i += 1\n    } else if c == \";\" {\n      while i < n && cs[i] != \"\\n\" {\n        i += 1\n        col += 1\n      }\n    } else if c == \"(\" {\n      let fresh: List<Node> = []\n      append(&stack, fresh)\n      append(&ol, line)\n      append(&oc, col)\n      i += 1\n      col += 1\n    } else if c == \")\" {\n      if len(stack) == 1 {\n        return Err(Fail { msg: \"unexpected )\", line: line, col: col })\n      }\n      let done = pop(&stack)\n      let ll = pop(&ol)\n      let cc = pop(&oc)\n      let top = len(stack) - 1\n      append(&stack[top], Lst(done, ll, cc))\n      i += 1\n      col += 1\n    } else {\n      let sl = line\n      let sc = col\n      var j = i\n      var s = \"\"\n      while j < n && !is_delim(cs[j]) {\n        s += cs[j]\n        j += 1\n      }\n      col += j - i\n      i = j\n      let node = classify(s, sl, sc)?\n      let top = len(stack) - 1\n      append(&stack[top], node)\n    }\n  }\n  if len(stack) > 1 {\n    return Err(Fail { msg: \"unclosed (\", line: ol[1], col: oc[1] })\n  }\n  Ok(stack[0])\n}\n\nfn head_name(n: Node) -> String {\n  match n {\n    Sym(name, _, _) => name\n    Num(_, _, _) | Bol(_, _, _) | Lst(_, _, _) => \"\"\n  }\n}\n\nfn list_items(n: Node) -> Option<List<Node>> {\n  match n {\n    Lst(items, _, _) => Some(items)\n    Num(_, _, _) | Bol(_, _, _) | Sym(_, _, _) => None\n  }\n}\n\nfn lookup(w: World, locals: Map<String, Val>, name: String) -> Option<Val> {\n  let lv = get(locals, name)\n  if lv != None {\n    return lv\n  }\n  let gv = get(w.globals, name)\n  if gv != None {\n    return gv\n  }\n  if name == \"+\" || name == \"-\" || name == \"*\" || name == \"/\" || name == \"<\" || name == \"=\" {\n    return Some(VFn(name, -1))\n  }\n  None\n}\n\nfn arith(name: String, x: Int, y: Int, l: Int, c: Int) -> Result<Val, Fail> {\n  if name == \"<\" {\n    return Ok(VBool(x < y))\n  }\n  if name == \"=\" {\n    return Ok(VBool(x == y))\n  }\n  var r = 0\n  if name == \"+\" {\n    r = x + y\n  } else if name == \"-\" {\n    r = x - y\n  } else if name == \"*\" {\n    r = x * y\n  } else {\n    if y == 0 {\n      return Err(Fail { msg: \"division by zero\", line: l, col: c })\n    }\n    r = x / y\n  }\n  if r < -9999999 || r > 9999999 {\n    return Err(Fail { msg: \"overflow\", line: l, col: c })\n  }\n  Ok(VNum(r))\n}\n\nfn builtin(name: String, a: Val, b: Val, l: Int, c: Int) -> Result<Val, Fail> {\n  let te = Fail { msg: \"type error\", line: l, col: c }\n  match a {\n    VNum(x) => {\n      match b {\n        VNum(y) => arith(name, x, y, l, c)\n        VBool(_) | VFn(_, _) => Err(te)\n      }\n    }\n    VBool(x) => {\n      match b {\n        VBool(y) => {\n          if name == \"=\" { Ok(VBool(x == y)) } else { Err(te) }\n        }\n        VNum(_) | VFn(_, _) => Err(te)\n      }\n    }\n    VFn(_, _) => Err(te)\n  }\n}\n\nfn call_fn(w: World, idx: Int, name: String, vals: List<Val>, l: Int, c: Int, depth: Int) -> Result<Val, Fail> {\n  if idx >= 0 {\n    let f = w.fns[idx]\n    if len(vals) - 1 != len(f.params) {\n      return Err(Fail { msg: \"wrong arity\", line: l, col: c })\n    }\n    if depth >= 50 {\n      return Err(Fail { msg: \"too deep\", line: l, col: c })\n    }\n    var env: Map<String, Val> = [:]\n    for k in 0..<len(f.params) {\n      let key = f.params[k]\n      env[key] = vals[k + 1]\n    }\n    return eval(w, f.body, env, depth + 1)\n  }\n  if len(vals) != 3 {\n    return Err(Fail { msg: \"wrong arity\", line: l, col: c })\n  }\n  builtin(name, vals[1], vals[2], l, c)\n}\n\nfn eval_if(w: World, items: List<Node>, l: Int, c: Int, locals: Map<String, Val>, depth: Int) -> Result<Val, Fail> {\n  if len(items) != 4 {\n    return Err(Fail { msg: \"bad if\", line: l, col: c })\n  }\n  let cv = eval(w, items[1], locals, depth)?\n  match cv {\n    VBool(b) => {\n      if b { ev