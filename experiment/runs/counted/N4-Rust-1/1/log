ines.iter().enumerate() {\n        let n = idx + 1;\n        let words: Vec<&str> = line.split(' ').filter(|w| !w.is_empty()).collect();\n        if words.is_empty() {\n            continue;\n        }\n        if !have_members {\n            if words[0] != \"members\" {\n                err(format!(\"error: line {}: expected members\", n));\n            }\n            if words.len() < 2 {\n                err(format!(\"error: line {}: no members\", n));\n            }\n            for w in &words[1..] {\n                if w.matches(':').count() != 1 {\n                    err(format!(\"error: line {}: bad member {}\", n, w));\n                }\n                let mut it = w.splitn(2, ':');\n                let nm = it.next().unwrap();\n                let wt = it.next().unwrap();\n                if !valid_name(nm) {\n                    err(format!(\"error: line {}: bad member {}\", n, w));\n                }\n                let wb = wt.as_bytes();\n                if wb.is_empty() || wb.len() > 2 || !wb.iter().all(|c| c.is_ascii_digit()) {\n                    err(format!(\"error: line {}: bad weight {}\", n, w));\n                }\n                let v: i64 = wt.parse().unwrap();\n                if v < 1 || v > 99 {\n                    err(format!(\"error: line {}: bad weight {}\", n, w));\n                }\n                if names.iter().any(|x| x == nm) {\n                    err(format!(\"error: line {}: duplicate member {}\", n, nm));\n                }\n                names.push(nm.to_string());\n                weights.push(v);\n            }\n            have_members = true;\n            totals = vec![0; names.len()];\n            continue;\n        }\n        if words[0] != \"cost\" {\n            err(format!(\"error: line {}: unknown command {}\", n, words[0]));\n        }\n        if words.len() < 3 {\n            err(format!(\"error: line {}: incomplete cost\", n));\n        }\n        if !valid_name(words[1]) {\n            err(format!(\"error: line {}: bad cost name\", n));\n        }\n        let amt = match parse_amount(words[2]) {\n            Some(v) => v,\n            None => err(format!(\"error: line {}: bad amount\", n)),\n        };\n        let mut sel: Vec<usize> = Vec::new();\n        if words.len() == 3 {\n            sel = (0..names.len()).collect();\n        } else {\n            for w in &words[3..] {\n                match names.iter().position(|x| x == w) {\n                    None => err(format!(\"error: line {}: unknown member {}\", n, w)),\n                    Some(i) => {\n                        if sel.contains(&i) {\n                            err(format!(\"error: line {}: duplicate member {}\", n, w));\n                        }\n                        sel.push(i);\n                    }\n                }\n            }\n        }\n        sel.sort();\n        let a = amt.abs();\n        let wsum: i64 = sel.iter().map(|&i| weights[i]).sum();\n        let mut base: Vec<i64> = Vec::new();\n        let mut rem: Vec<i64> = Vec::new();\n        for &i in &sel {\n            let p = a * weights[i];\n            let b = p / wsum;\n            base.push(b);\n            rem.push(p - b * wsum);\n        }\n        let k = a - base.iter().sum::<i64>();\n        let mut order: Vec<usize> = (0..sel.len()).collect();\n        order.sort_by(|&x, &y| rem[y].cmp(&rem[x]).then(x.cmp(&y)));\n        for j in 0..(k as usize) {\n            base[order[j]] += 1;\n        }\n        out.push_str(words[1]);\n        out.push(':');\n        for (j, &i) in sel.iter().enumerate() {\n            let s = if amt < 0 { -base[j] } else { base[j] };\n            totals[i] += s;\n            out.push_str(if j == 0 { \" \" } else { \", \" });\n            out.push_str(&format!(\"{} {}\", names[i], fmt_amt(s)));\n        }\n        out.push('\\n');\n        g += amt;\n        ncost += 1;\n    }\n    if !have_members {\n        err(\"error: no members\".to_string());\n    }\n    if ncost == 0 {\n        err