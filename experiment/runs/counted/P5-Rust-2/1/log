n() {\n    let path = std::env::args().nth(1).unwrap();\n    let bytes = std::fs::read(&path).unwrap();\n    let src = String::from_utf8_lossy(&bytes).to_string();\n    let items = match parse(&src) {\n        Ok(i) => i,\n        Err((l, c, w)) => {\n            println!(\"error: line {} col {}: {}\", l, c, w);\n            std::process::exit(20);\n        }\n    };\n    let mut it = I { globals: HashMap::new(), depth: 0 };\n    let mut out = String::new();\n    for n in &items {\n        match it.top(n) {\n            Ok(None) => {}\n            Ok(Some(v)) => match v {\n                V::Num(x) => out.push_str(&format!(\"{}\\n\", x)),\n                V::Bool(b) => out.push_str(if b { \"#t\\n\" } else { \"#f\\n\" }),\n                V::Fn(f) => out.push_str(&format!(\"<fn {}>\\n\", f.name)),\n            },\n            Err(e) => {\n                print!(\"{}\", out);\n                println!(\"error: line {} col {}: {}\", e.line, e.col, e.what);\n                std::process::exit(20);\n            }\n        }\n    }\n    print!(\"{}\", out);\n}\n\nfn main() {\n    let h = std::thread::Builder::new()\n        .stack_size(512 * 1024 * 1024)\n        .spawn(run)\n        .unwrap();\n    h.join().unwrap();\n}\n```","input":3222,"output":5054,"cut_off":false,"ms":28932,"at":1792053773319}
