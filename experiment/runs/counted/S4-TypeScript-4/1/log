00 + parseInt(m[3], 10);\n      const cnt = parseInt(m[4], 10);\n      if (credit !== 0) {\n        out.push(\"busy\");\n        continue;\n      }\n      const s = slots.get(slot);\n      if ((s && s.n + cnt > 20) || (!s && cnt > 20)) {\n        out.push(\"slot full \" + slot);\n        continue;\n      }\n      if (s) {\n        s.price = price;\n        s.n += cnt;\n      } else slots.set(slot, { price, n: cnt });\n    } else if ((m = coinRe.exec(l))) {\n      const v = parseInt(m[1], 10);\n      const idx = coins.indexOf(v);\n      if (idx < 0 || credit + v > 500) {\n        out.push(\"rejected \" + money(v));\n        continue;\n      }\n      box[idx]++;\n      credit += v;\n      session.push(v);\n    } else if ((m = selRe.exec(l))) {\n      const slot = m[1];\n      const s = slots.get(slot);\n      if (!s) {\n        out.push(\"no slot \" + slot);\n        continue;\n      }\n      if (s.n === 0) {\n        out.push(\"sold out \" + slot);\n        continue;\n      }\n      if (credit < s.price) {\n        out.push(\"insert \" + money(s.price - credit) + \" more\");\n        continue;\n      }\n      const change = credit - s.price;\n      let rem = change;\n      const taken: number[] = [];\n      const takeCount = [0, 0, 0, 0, 0, 0];\n      for (let k = 5; k >= 0; k--) {\n        const t = Math.min(box[k], Math.floor(rem / coins[k]));\n        takeCount[k] = t;\n        rem -= t * coins[k];\n        for (let j = 0; j < t; j++) taken.push(coins[k]);\n      }\n      if (rem !== 0) {\n        out.push(\"no change\");\n        continue;\n      }\n      s.n--;\n      for (let k = 0; k < 6; k++) box[k] -= takeCount[k];\n      credit = 0;\n      session = [];\n      if (change === 0) out.push(\"sold \" + slot);\n      else out.push(\"sold \" + slot + \", change \" + money(change) + \": \" + taken.map(money).join(\" \"));\n    } else {\n      if (credit === 0) {\n        out.push(\"nothing to return\");\n        continue;\n      }\n      for (const v of session) box[coins.indexOf(v)]--;\n      out.push(\"returned \" + money(credit) + \": \" + session.map(money).join(\" \"));\n      credit = 0;\n      session = [];\n    }\n  }\n  out.push(\"credit \" + money(credit));\n  out.push(\"box \" + box.join(\" \"));\n  const names = Array.from(slots.keys()).sort();\n  for (const n of names) {\n    const s = slots.get(n)!;\n    out.push(n + \": \" + s.n + \" at \" + money(s.price));\n  }\n  process.stdout.write(out.join(\"\\n\") + \"\\n\");\n}\nmain();\n```","input":3198,"output":2354,"cut_off":false,"ms":13382,"at":1792054894698}
