{"event":"submission","n":1,"source":"use std::collections::HashMap;\nuse std::io::Write;\n\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    let n_arg = args.get(2).cloned().unwrap_or_default();\n    let valid = !n_arg.is_empty() && n_arg.bytes().all(|b| b.is_ascii_digit());\n    let mut n: usize = 0;\n    if valid {\n        let t = n_arg.trim_start_matches('0');\n        if t.len() <= 4 {\n            n = if t.is_empty() { 0 } else { t.parse().unwrap() };\n        }\n    }\n    if !valid || n < 1 || n > 1000 {\n        println!(\"error: bad count\");\n        std::process::exit(20);\n    }\n    let data = std::fs::read(&args[1]).unwrap_or_default();\n    let mut map: HashMap<Vec<u8>, usize> = HashMap::new();\n    let mut cur: Vec<u8> = Vec::new();\n    for &b in data.iter().chain(std::iter::once(&b' ')) {\n        if b.is_ascii_alphabetic() {\n            cur.push(b.to_ascii_lowercase());\n        } else if !cur.is_empty() {\n            *map.entry(std::mem::take(&mut cur)).or_insert(0) += 1;\n        }\n    }\n    if map.is_empty() {\n        println!(\"no words\");\n        return;\n    }\n    let mut v: Vec<(Vec<u8>, usize)> = map.into_iter().collect();\n    v.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| a.0.cmp(&b.0)));\n    let mut out = std::io::stdout().lock();\n    for (w, c) in v.into_iter().take(n) {\n        out.write_all(format!(\"{} \", c).as_bytes()).unwrap();\n        out.write_all(&w).unwrap();\n        out.write_all(b\"\\n\").unwrap();\n    }\n}\n"}
