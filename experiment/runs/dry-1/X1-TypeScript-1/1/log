{"event":"submission","n":1,"source":"import * as fs from \"fs\";\n\nconst args = process.argv.slice(2);\nconst nArg = args[0] === undefined ? \"\" : args[1] === undefined ? \"\" : args[1];\nconst file = args[0];\n\nif (!/^[0-9]+$/.test(nArg) || parseInt(nArg, 10) < 1 || parseInt(nArg, 10) > 1000) {\n  process.stdout.write(\"error: bad count\\n\");\n  process.exitCode = 20;\n} else {\n  const n = parseInt(nArg, 10);\n  const text = fs.readFileSync(file, \"latin1\");\n  const counts = new Map<string, number>();\n  const m = text.match(/[A-Za-z]+/g);\n  if (m) {\n    for (const w of m) {\n      const l = w.toLowerCase();\n      counts.set(l, (counts.get(l) ?? 0) + 1);\n    }\n  }\n  if (counts.size === 0) {\n    process.stdout.write(\"no words\\n\");\n  } else {\n    const arr = Array.from(counts.entries());\n    arr.sort((a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0));\n    let out = \"\";\n    for (const [w, c] of arr.slice(0, n)) out += c + \" \" + w + \"\\n\";\n    process.stdout.write(out);\n  }\n}\n"}
