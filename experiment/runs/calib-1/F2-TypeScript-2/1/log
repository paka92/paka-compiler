{"event":"reply","n":1,"text":"```typescript\nimport * as fs from \"fs\";\n\nfunction fail(msg: string): never {\n  process.stdout.write(msg + \"\\n\");\n  process.exit(20);\n}\n\nconst args = process.argv.slice(2);\nconst inName = args[0];\nconst fArg = args[1];\nconst idxName = args[2];\n\nif (!/^[0-9]+$/.test(fArg) || parseInt(fArg, 10) < 1 || parseInt(fArg, 10) > 9) {\n  fail(\"error: bad field\");\n}\nconst F = parseInt(fArg, 10);\n\nlet data: string;\ntry {\n  data = fs.readFileSync(inName, \"latin1\");\n} catch (e) {\n  fail(\"error: cannot read \" + inName);\n}\n\nconst lines = data.split(\"\\n\");\nif (lines.length > 0 && lines[lines.length - 1] === \"\") lines.pop();\n\ninterface Entry { key: string; name: string; rows: string[]; }\nconst byKey = new Map<string, Entry>();\nconst byName = new Map<string, string>();\nlet R = 0;\n\nfunction fileName(key: string): string {\n  let s = key.replace(/[A-Z]/g, (c) => c.toLowerCase());\n  s = s.replace(/[^a-z0-9]/g, \"_\");\n  return s + \".txt\";\n}\n\nfor (let i = 0; i < lines.length; i++) {\n  const line = lines[i];\n  if (line === \"\") continue;\n  const n = i + 1;\n  const fields = line.split(\",\");\n  if (fields.length < F) fail(`error: line ${n}: no field ${F}`);\n  const key = fields[F - 1];\n  if (key === \"\") fail(`error: line ${n}: empty key`);\n  const rest = fields.filter((_, j) => j !== F - 1).join(\",\");\n  let e = byKey.get(key);\n  if (!e) {\n    const name = fileName(key);\n    const earlier = byName.get(name);\n    if (earlier !== undefined) {\n      fail(`error: line ${n}: ${key} clashes with ${earlier} in ${name}`);\n    }\n    e = { key, name, rows: [] };\n    byKey.set(key, e);\n    byName.set(name, key);\n  }\n  e.rows.push(rest);\n  R++;\n}\n\nconst entries = Array.from(byKey.values());\nentries.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));\n\nfor (const e of entries) {\n  try {\n    fs.writeFileSync(e.name, e.rows.map((r) => r + \"\\n\").join(\"\"), \"latin1\");\n  } catch (err) {\n    fail(\"error: cannot write \" + e.name);\n  }\n}\ntry {\n  fs.writeFileSync(\n    idxName,\n    entries.map((e) => `${e.name} ${e.rows.length} ${e.key}\\n`).join(\"\"),\n    \"latin1\"\n  );\n} catch (err) {\n  fail(\"error: cannot write \" + idxName);\n}\n\nconst K = entries.length;\nprocess.stdout.write(\n  `split ${R} ${R === 1 ? \"record\" : \"records\"} into ${K} ${K === 1 ? \"file\" : \"files\"}\\n`\n);\nprocess.exit(0);\n```","input":3064,"output":1462,"cut_off":false,"ms":10130,"at":1791999879964}
