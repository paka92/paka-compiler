{"event":"reply","n":1,"text":"```rust\nuse std::collections::BTreeMap;\nuse std::io::Write;\n\nfn fmt(x: f64) -> String {\n    let s = format!(\"{:.2}\", x);\n    if s == \"-0.00\" { \"0.00\".to_string() } else { s }\n}\n\nfn valid_name(s: &str) -> bool {\n    let n = s.len();\n    n >= 1 && n <= 20 && s.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_' || c == b'-')\n}\n\nfn parse_val(w: &str) -> Option<i64> {\n    let (neg, d) = match w.strip_prefix('-') {\n        Some(r) => (true, r),\n        None => (false, w),\n    };\n    if d.is_empty() || d.len() > 5 || !d.bytes().all(|c| c.is_ascii_digit()) {\n        return None;\n    }\n    let v: i64 = d.parse().ok()?;\n    Some(if neg { -v } else { v })\n}\n\nfn main() {\n    let path = std::env::args().nth(1).unwrap();\n    let data = std::fs::read(&path).unwrap();\n    let text = String::from_utf8_lossy(&data).to_string();\n    let mut groups: BTreeMap<String, Vec<i64>> = BTreeMap::new();\n    for (i, line) in text.split('\\n').enumerate() {\n        let ln = i + 1;\n        let words: Vec<&str> = line.split(' ').filter(|w| !w.is_empty()).collect();\n        if words.is_empty() {\n            continue;\n        }\n        let first = words[0];\n        let name = match first.strip_suffix(':') {\n            Some(n) if valid_name(n) => n,\n            _ => {\n                println!(\"error: line {}: bad line\", ln);\n                std::process::exit(20);\n            }\n        };\n        let mut vals = Vec::new();\n        for w in &words[1..] {\n            match parse_val(w) {\n                Some(v) => vals.push(v),\n                None => {\n                    println!(\"error: line {}: bad value {}\", ln, w);\n                    std::process::exit(20);\n                }\n            }\n        }\n        groups.entry(name.to_string()).or_default().extend(vals);\n    }\n    if groups.is_empty() {\n        println!(\"error: no groups\");\n        std::process::exit(20);\n    }\n    let mut out = String::new();\n    for (name, v) in groups.iter_mut() {\n        let n = v.len();\n        v.sort();\n        let (mean, med, sd);\n        if n == 0 {\n            mean = \"-\".to_string();\n            med = \"-\".to_string();\n            sd = \"-\".to_string();\n        } else {\n            let sum: i64 = v.iter().sum();\n            let m = sum as f64 / n as f64;\n            mean = fmt(m);\n            let md = if n % 2 == 1 {\n                v[n / 2] as f64\n            } else {\n                (v[n / 2 - 1] + v[n / 2]) as f64 / 2.0\n            };\n            med = fmt(md);\n            if n >= 2 {\n                let q: f64 = v.iter().map(|&x| (x as f64 - m) * (x as f64 - m)).sum();\n                sd = fmt((q / (n as f64 - 1.0)).sqrt());\n            } else {\n                sd = \"-\".to_string();\n            }\n        }\n        out.push_str(&format!(\"{}: n={} mean={} median={} sd={}\\n\", name, n, mean, med, sd));\n    }\n    std::io::stdout().write_all(out.as_bytes()).unwrap();\n}\n```","input":2467,"output":1548,"cut_off":false,"ms":9720,"at":1791999725102}
