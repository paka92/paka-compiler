4>, Option<i64>),\n    Weekday(Option<i64>),\n    Add(Option<i64>, i64),\n    Holiday(Option<i64>),\n}\n\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    let data = std::fs::read(&args[1]).unwrap();\n    let text: String = data.iter().map(|&c| c as char).collect();\n    let mut lines: Vec<&str> = text.split('\\n').collect();\n    if let Some(l) = lines.last() {\n        if l.is_empty() {\n            lines.pop();\n        }\n    }\n    let mut cmds: Vec<(usize, Cmd)> = Vec::new();\n    for (i, line) in lines.iter().enumerate() {\n        let n = i + 1;\n        if line.is_empty() {\n            continue;\n        }\n        let t: Vec<&str> = line.split(' ').collect();\n        let bad = || -> ! {\n            println!(\"error: line {}: bad command\", n);\n            std::process::exit(20);\n        };\n        let cmd = match t[0] {\n            \"days\" if t.len() == 3 && fmt_ok(t[1]) && fmt_ok(t[2]) => {\n                Cmd::Days(parse_date(t[1]), parse_date(t[2]))\n            }\n            \"weekday\" if t.len() == 2 && fmt_ok(t[1]) => Cmd::Weekday(parse_date(t[1])),\n            \"add\" if t.len() == 3 && fmt_ok(t[1]) && count_ok(t[2]) => {\n                Cmd::Add(parse_date(t[1]), t[2].parse().unwrap())\n            }\n            \"holiday\" if t.len() == 2 && fmt_ok(t[1]) => Cmd::Holiday(parse_date(t[1])),\n            _ => bad(),\n        };\n        let ok = match &cmd {\n            Cmd::Days(a, b) => a.is_some() && b.is_some(),\n            Cmd::Weekday(a) => a.is_some(),\n            Cmd::Add(a, _) => a.is_some(),\n            Cmd::Holiday(a) => a.is_some(),\n        };\n        if !ok {\n            println!(\"error: line {}: bad date\", n);\n            std::process::exit(20);\n        }\n        cmds.push((n, cmd));\n    }\n    let mut hol: HashSet<i64> = HashSet::new();\n    for (_, c) in &cmds {\n        if let Cmd::Holiday(Some(d)) = c {\n            hol.insert(*d);\n        }\n    }\n    let maxd = dn(2100, 12, 31)