 }\n                }\n            }\n            col += 1;\n            i += 1;\n        } else {\n            let st = i;\n            while i < chars.len() && !matches!(chars[i], ' ' | '\\n' | '(' | ')' | ';') {\n                i += 1;\n            }\n            let s: String = chars[st..i].iter().collect();\n            match parse_atom(&s) {\n                None => return Err((line, col, \"bad atom\".to_string())),\n                Some(k) => {\n                    let n = Node { line, col, kind: k };\n                    match stack.last_mut() {\n                        Some(t) => t.0.push(n),\n                        None => top.push(n),\n                    }\n                }\n            }\n            col += i - st;\n        }\n    }\n    if let Some((_, l, c)) = stack.first() {\n        return Err((*l, *c, \"unclosed (\".to_string()));\n    }\n    Ok(top)\n}\n\nfn run(prog: &[Node], out: &mut String) -> Result<(), Err> {\n    let mut ctx = Ctx { globals: HashMap::new(), depth: 0 };\n    let env: Env = vec![];\n    for n in prog {\n        if let Kind::List(items) = &n.kind {\n            if !items.is_empty() && is_sym(&items[0], \"define\") {\n                let bad = || Err(Err_(n));\n                fn Err_(n: &Node) -> Err {\n                    Err(n.line, n.col, \"bad define\".to_string())\n                }\n                if items.len() != 3 {\n                    return bad();\n                }\n                match &items[1].kind {\n                    Kind::Sym(_) => {\n                        let name = match name_of(&items[1]) {\n                            Some(s) => s.to_string(),\n                            None => return bad(),\n                        };\n                        let v = eval(&items[2], &env, &mut ctx)?;\n                        ctx.globals.insert(name, v);\n                    }\n                    Kind::List(sig) => {\n                        if sig.is_empty() {\n                            return bad();\n    