rue;\n        j++;\n      }\n      if (j >= line.length) throw new SynErr(opens[0] + 1, \"unclosed brace\");\n      if (!isLower(line[j])) throw new SynErr(i + 1, \"bad reference\");\n      const e = readName(line, j);\n      const name = line.slice(j, e);\n      j = e;\n      if (j >= line.length) throw new SynErr(opens[0] + 1, \"unclosed brace\");\n      if (isLen) {\n        if (line[j] !== \"}\") throw new SynErr(i + 1, \"bad reference\");\n        pieces.push({ t: \"len\", name });\n        i = j + 1;\n      } else if (line[j] === \"}\") {\n        pieces.push({ t: \"ref\", name });\n        i = j + 1;\n      } else if (line[j] === \":\") {\n        if (j + 1 >= line.length) throw new SynErr(opens[0] + 1, \"unclosed brace\");\n        if (line[j + 1] !== \"-\") throw new SynErr(i + 1, \"bad reference\");\n        const r = parse(line, j + 2, true, opens);\n        pieces.push({ t: \"def\", name, def: r.pieces });\n        i = r.i + 1;\n      } else {\n        throw new SynErr(i + 1, \"bad reference\");\n      }\n      opens.pop();\n    } else {\n      throw new SynErr(i + 1, \"bad dollar\");\n    }\n  }\n}\n\nfunction main() {\n  const data = fs.readFileSync(process.argv[2], \"latin1\");\n  const lines = data.split(\"\\n\");\n  if (lines.length && lines[lines.length - 1] === \"\") lines.pop();\n  const order: string[] = [];\n  const pieces = new Map<string, Piece[]>();\n  const fail = (m: string) => {\n    process.stdout.write(m + \"\\n\");\n    process.exitCode = 20;\n  };\n  for (let ln = 0; ln < lines.length; ln++) {\n    const line = lines[ln];\n    if (line === \"\" || line[0] === \"#\") continue;\n    try {\n      if (!isLower(line[0])) throw new SynErr(1, \"bad name\");\n      const e = readName(line, 0);\n      if (line[e] !== \"=\") throw new SynErr(e + 1, \"bad name\");\n      const name = line.slice(0, e);\n      const r = parse(line, e + 1, false, []);\n      if (!pieces.has(name)) order.push(name);\n      pieces.set(name, r.pieces);\n    } catch (x) {\n      if (x instanceof SynErr) {\n        fail(`error: line ${ln + 1} col ${x.col}: ${x.msg}`);\n        return;\n      }\n      throw x;\n    }\n  }\n  const done = new Map<string, string>();\n  const chain: string[] = [];\n  class ExpErr {\n    constructor(public m: string) {}\n  }\n  const expandVar = (name: string): string => {\n    const d = done.get(name);\n    if (d !== undefined) return d;\n    const idx = chain.indexOf(name);\n    if (idx >= 0) {\n      throw new ExpErr(\"error: cycle \" + chain.slice(idx).concat([name]).join(\" -> \"));\n    }\n    chain.push(name);\n    const out = evalPieces(pieces.get(name)!, name);\n    chain.pop();\n    done.set(name, out);\n    return out;\n  };\n  const need = (n: string, owner: string): string => {\n    if (!pieces.has(n)) throw new ExpErr(`error: undefined ${n} in ${owner}`);\n    return expandVar(n);\n  };\n  const evalPieces = (ps: Piece[], owner: string): string => {\n    let s = \"\";\n    for (const p of ps) {\n      if (p.t === \"text\") s += p.s;\n      else if (p.t === \"ref\") s += need(p.name, owner);\n      else if (p.t === \"len\") s += String(need(p.name, owner).length);\n      else {\n        if (!pieces.has(p.name)) s += evalPieces(p.def, owner);\n        else {\n          const v = expandVar(p.name);\n          s += v === \"\" ? evalPieces(p.def, owner) : v;\n        }\n      }\n    }\n    return s;\n  };\n  try {\n    let out = \"\";\n    for (const n of order) out += n + \"=\" + expandVar(n) + \"\\n\";\n    process.stdout.write(out);\n  } catch (x) {\n    if (x instanceof ExpErr) {\n      fail(x.m);\n      return;\n    }\n    throw x;\n  }\n}\nmain();\n```","input":6883,"output":7413,"cut_off":false,"ms":53633,"at":1792010613581}
