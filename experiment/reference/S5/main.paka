enum Msg { Start(path: String), Loaded(text: String), Failed(why: String) }

enum Command { Add(text: String), Set(text: String), Del, Up, Down, Undo, Redo, Show }

type State { lines: List<String> = [], current: Int = 0 }

type Step { before: State, after: State }

type Editor { state: State, undo: List<Step> = [], redo: List<Step> = [] }

fn parse(line: String) -> Option<Command> {
  if starts_with(line, "add ") { return Some(Add(line[4..<len(line)])) }
  if starts_with(line, "set ") { return Some(Set(line[4..<len(line)])) }
  match line {
    "del" => Some(Del)
    "up" => Some(Up)
    "down" => Some(Down)
    "undo" => Some(Undo)
    "redo" => Some(Redo)
    "print" => Some(Show)
    _ => None
  }
}

fn is_add(c: Command) -> Bool {
  match c {
    Add(_) => true
    Set(_) | Del | Up | Down | Undo | Redo | Show => false
  }
}

fn needs_lines(c: Command) -> Bool {
  match c {
    Set(_) | Del | Up | Down => true
    Add(_) | Undo | Redo | Show => false
  }
}

// Runs one command; gives the lines it prints, or the reason it is rejected.
// `joins` tells whether an add joins the last step.
fn apply(e: inout Editor, c: Command, joins: Bool) -> Result<List<String>, String> {
  let before = e.state
  let at = e.state.current - 1
  if needs_lines(c) && is_empty(e.state.lines) { return Err("empty buffer") }
  match c {
    Add(text) => {
      insert(&e.state.lines, text, at: e.state.current)
      e.state.current += 1
    }
    Set(text) => {
      if e.state.lines[at] == text { return Ok([]) }
      e.state.lines[at] = text
    }
    Del => {
      _ = remove_at(&e.state.lines, at)
      e.state.current = min(e.state.current, len(e.state.lines))
    }
    Up => {
      if e.state.current == 1 { return Err("at top") }
      e.state.current -= 1
      return Ok([])
    }
    Down => {
      if e.state.current == len(e.state.lines) { return Err("at bottom") }
      e.state.current += 1
      return Ok([])
    }
    Undo => {
      if is_empty(e.undo) { return Err("nothing to undo") }
      let step = pop(&e.undo)
      e.state = step.before
      append(&e.redo, step)
      return Ok([])
    }
    Redo => {
      if is_empty(e.redo) { return Err("nothing to redo") }
      let step = pop(&e.redo)
      e.state = step.after
      append(&e.undo, step)
      return Ok([])
    }
    Show => {
      return Ok(show(e.state))
    }
  }
  let after = e.state
  if joins {
    let last = len(e.undo) - 1
    e.undo[last].after = after
  } else {
    append(&e.undo, Step { before: before, after: after })
    if len(e.undo) > 3 { _ = remove_at(&e.undo, 0) }
    e.redo = []
  }
  Ok([])
}

fn show(s: State) -> List<String> {
  let n = len(s.lines)
  let width = len("{n}")
  var out = ["[{s.current}/{n}]"]
  for i in 0..<n {
    let mark = if i + 1 == s.current { ">" } else { " " }
    append(&out, mark + pad_left("{i + 1}", width) + "|" + s.lines[i])
  }
  out
}

fn run(text: String) -> Result<List<String>, String> {
  let all = lines(text)
  var commands: List<Command> = []
  for i in 0..<len(all) {
    append(&commands, ok_or(parse(all[i]), "line {i + 1}: bad command")?)
  }
  var e = Editor { state: State {} }
  var out: List<String> = []
  for i in 0..<len(commands) {
    let joins = i > 0 && is_add(commands[i - 1]) && is_add(commands[i])
    match apply(&e, commands[i], joins) {
      Ok(shown) => extend(&out, shown)
      Err(reason) => append(&out, "line {i + 1}: {reason}")
    }
  }
  append(&out, "undo {len(e.undo)}, redo {len(e.redo)}")
  Ok(out)
}

fn report(result: Result<List<String>, String>) -> List<Effect<Msg>> {
  match result {
    Ok(out) => {
      var effects: List<Effect<Msg>> = []
      for line in out {
        append(&effects, Print(line))
      }
      append(&effects, Exit)
      effects
    }
    Err(why) => [Print("error: {why}"), ExitWith(20)]
  }
}

fn update(m: Msg) -> List<Effect<Msg>> {
  match m {
    Start(path) => [ReadFile(path, then: Loaded, or: Failed)]
    Loaded(text) => report(run(text))
    Failed(why) => [Print("error: cannot read file: {why}"), ExitWith(20)]
  }
}

app line_editor {
  start: Start
  update: update
  grants: [Console, ReadFiles]
}
