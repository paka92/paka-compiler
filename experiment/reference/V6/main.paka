enum Msg {
  Start(mode: String, first: String, second: String),
  ListLoaded(text: String),
  FileLoaded(text: String),
  ArchiveLoaded(text: String),
  ReadFailed(why: String),
  Wrote,
  WriteFailed(why: String)
}

type Job { name: String, text: String }

// `reading` is the file whose answer is awaited; `files` the files read or to write, in order.
type Packer {
  archive: String = "",
  which: String = "",
  reading: String = "",
  names: List<String> = [],
  files: List<Job> = [],
  written: Int = 0,
  summary: String = ""
}

fn is_name(s: String) -> Bool {
  if len(s) < 1 || len(s) > 30 { return false }
  let alnum = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
  if !contains(alnum, s[0]) { return false }
  for c in chars(s) {
    if !contains(alnum + "._-", c) { return false }
  }
  true
}

// A decimal number of 1 to `most` digits with no leading zero unless it is 0.
fn count(s: String, most: Int) -> Option<Int> {
  if len(s) < 1 || len(s) > most || len(s) > 1 && s[0] == "0" { return None }
  for c in chars(s) {
    if c < "0" || c > "9" { return None }
  }
  parse_int(s)
}

fn files_word(n: Int) -> String {
  if n == 1 { "{n} file" } else { "{n} files" }
}

fn check_list(text: String) -> Result<List<String>, String> {
  var names: List<String> = []
  let rows = lines(text)
  for i in 0..<len(rows) {
    let name = rows[i]
    if !is_name(name) { return Err("error: list line {i + 1}: bad name") }
    if contains(names, name) { return Err("error: list line {i + 1}: duplicate {name}") }
    append(&names, name)
  }
  Ok(names)
}

fn archive_text(files: List<Job>) -> String {
  var parts = ["archive {len(files)}\n"]
  for f in files {
    append(&parts, "entry {f.name} {len(f.text)}\n{f.text}\n")
  }
  join(parts, "")
}

fn line_feeds(s: String) -> Int {
  len(split(s, "\n")) - 1
}

// The entries of an archive, in order.
fn read_archive(text: String) -> Result<List<Job>, String> {
  var rest = text
  var k = 1
  let bad_header = "error: archive line 1: bad header"
  let header_end = ok_or(find(rest, "\n"), bad_header)?
  let header = split(rest[0..<header_end], " ")
  if len(header) != 2 || header[0] != "archive" { return Err(bad_header) }
  let n = ok_or(count(header[1], 3), bad_header)?
  rest = rest[header_end + 1..<len(rest)]
  k += 1
  var entries: List<Job> = []
  var names: List<String> = []
  while len(entries) < n {
    let bad_entry = "error: archive line {k}: bad entry"
    let line_end = ok_or(find(rest, "\n"), bad_entry)?
    let f = split(rest[0..<line_end], " ")
    if len(f) != 3 || f[0] != "entry" || !is_name(f[1]) { return Err(bad_entry) }
    let size = ok_or(count(f[2], 5), bad_entry)?
    let name = f[1]
    if contains(names, name) { return Err("error: archive line {k}: duplicate {name}") }
    let start = line_end + 1
    if len(rest) < start + size + 1 || rest[start + size] != "\n" {
      return Err("error: archive line {k}: bad length")
    }
    let content = rest[start..<start + size]
    append(&names, name)
    append(&entries, Job { name: name, text: content })
    k += 2 + line_feeds(content)
    rest = rest[start + size + 1..<len(rest)]
  }
  if !is_empty(rest) { return Err("error: archive line {k}: trailing data") }
  Ok(entries)
}

fn fail(why: String) -> List<Effect<Msg>> {
  [Print(why), ExitWith(20)]
}

fn read_next(s: inout Packer) -> List<Effect<Msg>> {
  if len(s.files) == len(s.names) {
    s.files = [Job { name: s.archive, text: archive_text(s.files) }]
    s.summary = "packed {files_word(len(s.names))} into {s.archive}"
    return write_next(s)
  }
  s.reading = s.names[len(s.files)]
  [ReadFile(s.reading, then: FileLoaded, or: ReadFailed)]
}

fn write_next(s: Packer) -> List<Effect<Msg>> {
  if s.written == len(s.files) { return [Print(s.summary), Exit] }
  let job = s.files[s.written]
  [WriteFile(job.name, job.text, then: Wrote, or: WriteFailed)]
}

fn unpack(s: inout Packer, text: String) -> List<Effect<Msg>> {
  match read_archive(text) {
    Ok(entries) => {
      for e in entries {
        if s.which == "*" || e.name == s.which { append(&s.files, e) }
      }
      if is_empty(s.files) && s.which != "*" { return fail("error: no entry {s.which}") }
      s.summary = "unpacked {files_word(len(s.files))} from {s.archive}"
      write_next(s)
    }
    Err(why) => fail(why)
  }
}

fn update(s: inout Packer, m: Msg) -> List<Effect<Msg>> {
  match m {
    Start(mode, first, second) => {
      if mode == "pack" {
        s.archive = second
        s.reading = first
        [ReadFile(first, then: ListLoaded, or: ReadFailed)]
      } else if mode == "unpack" {
        if second != "*" && !is_name(second) { return fail("error: bad name {second}") }
        s.archive = first
        s.which = second
        s.reading = first
        [ReadFile(first, then: ArchiveLoaded, or: ReadFailed)]
      } else {
        fail("error: bad mode")
      }
    }
    ListLoaded(text) => {
      match check_list(text) {
        Ok(names) => {
          s.names = names
          read_next(&s)
        }
        Err(why) => fail(why)
      }
    }
    FileLoaded(text) => {
      append(&s.files, Job { name: s.reading, text: text })
      read_next(&s)
    }
    ArchiveLoaded(text) => unpack(&s, text)
    ReadFailed(_) => fail("error: cannot read {s.reading}")
    Wrote => {
      s.written += 1
      write_next(s)
    }
    WriteFailed(_) => fail("error: cannot write {s.files[s.written].name}")
  }
}

app pack_unpack {
  state: Packer
  start: Start
  update: update
  grants: [Console, ReadFiles, WriteFiles]
}
